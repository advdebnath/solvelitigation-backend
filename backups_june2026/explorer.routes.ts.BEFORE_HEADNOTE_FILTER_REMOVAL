import { Router } from "express";
import mongoose from "mongoose";

import Judgment from "../models/judgment.model";

import {
  getExplorerHighlights
} from "../controllers/explorerHighlights.controller";
import {

  filterActsByCategory

} from "../services/legalOntology.service";


const router = Router();

// =====================================================
// 🔥 SAFE REGEX
// =====================================================

const escapeRegex = (
  text: string = ""
) =>
  text.replace(
    /[.*+?^${}()|[\]\\]/g,
    "\\$&"
  );

// =====================================================
// 🔥 PRODUCTION FILTER
// =====================================================

const VALID_JUDGMENT_FILTER: any = {

  isDeleted: {
    $ne: true
  },

  category: {
    $exists: true,
    $nin: ["", null, "Unknown"]
  },

  caseNumber: {
    $exists: true,
    $nin: [
      "",
      null,
      "Unknown Case"
    ]
  },

  headnote: {
    $exists: true,
    $nin: ["", null]
  },

  // ============================================
  // 🔥 QUALITY CONTROL
  // ============================================

  documentQuality:
    "HIGH_QUALITY",

  reviewStatus: {

    $in: [

      "PENDING",

      "APPROVED"
    ]
  },

  isPublished: true,
};


// =====================================================
// 🔥 1. CATEGORIES
// =====================================================

router.get(
  "/categories",

  async (_req, res) => {

    try {

      const categories =
        await Judgment.aggregate([

          {
            $match:
              VALID_JUDGMENT_FILTER
          },

          {
            $group: {

              _id:
                "$category",

              count: {
                $sum: 1
              }
            }
          },

          {
            $project: {

              _id: 0,

              name: "$_id",

              count: 1
            }
          },

          {
            $sort: {
              count: -1
            }
          }
        ]);

      res.json({

        success: true,

        data: categories
      });

    } catch (err) {

      console.error(
        "❌ Categories Error:",
        err
      );

      res.status(500).json({
        success: false
      });
    }
  }
);

// =====================================================
// 🔥 CATEGORY → ACTS
// =====================================================

router.get(

  "/category/:category",

  async (req, res) => {

    try {

      const category =
        req.params.category;

      const judgments =
        await Judgment.find({

          ...VALID_JUDGMENT_FILTER,

          category: {

            $regex: escapeRegex(
              category
            ),

            $options: "i"
          }
        })

        .select("actNames")

        .lean();

      const actCounter:
      Record<string, number> = {};

      for (const j of judgments) {

        let acts =
          Array.isArray(j.actNames)

            ? j.actNames

            : [];

        // ===========================================
        // 🔥 DYNAMIC ONTOLOGY FILTER
        // ===========================================

        acts =
          filterActsByCategory(

            acts,

            category
          );

        for (const rawAct of acts) {

          if (!rawAct) {
            continue;
          }

          const act =
            String(rawAct).trim();

          if (!act) {
            continue;
          }

          if (!actCounter[act]) {

            actCounter[act] = 0;
          }

          actCounter[act]++;
        }
      }

      const data =
        Object.entries(actCounter)

        .map(([act, count]) => ({

          act,

          count
        }))

        .sort((a, b) =>

          b.count - a.count
        );

      res.json({

        success: true,


        totalActs:
          data.length,

        data
      });

    } catch (err) {

      console.error(
        "❌ Category Error:",
        err
      );

      res.status(500).json({

        success: false,

        message:
          "Failed to fetch category acts"
      });
    }
  }
);

// =====================================================
// 🔥 ACT → SECTIONS
// =====================================================

router.get(

  "/acts/:act",

  async (req, res) => {

    try {

      const act =
        req.params.act;

      const sections =
        await Judgment.aggregate([

          {
            $match: {

              ...VALID_JUDGMENT_FILTER,

              actNames: {

                $regex:
                  escapeRegex(act),

                $options: "i"
              }
            }
          },

          {
            $unwind:
              "$sections"
          },

          {
            $match: {

              "sections.section": {
                $exists: true,
                $ne: null
              }
            }
          },

          {
            $group: {

              _id:
                "$sections.section",

              section: {

                $first:
                  "$sections"
              },

              count: {
                $sum: 1
              }
            }
          },

          {
            $project: {

              _id: 0,

              section: 1,

              count: 1
            }
          },

          {
            $sort: {
              count: -1
            }
          }
        ]);

      res.json({

        success: true,

        act,

        totalSections:
          sections.length,

        data: sections
      });

    } catch (err) {

      console.error(
        "❌ Act Route Error:",
        err
      );

      res.status(500).json({

        success: false,

        message:
          "Failed to fetch act sections"
      });
    }
  }
);


// =====================================================
// 🔥 3. SECTIONS
// =====================================================

router.get(

  "/sections",

  async (req, res) => {

    try {

      const act =
        req.query.act as string;

      const sections =
        await Judgment.aggregate([

          {
            $match: {

              ...VALID_JUDGMENT_FILTER,

              actNames: {

                $regex:
                  escapeRegex(act),

                $options: "i"
              }
            }
          },

          {
            $unwind:
              "$sections"
          },

          {
            $match: {

              "sections.section": {
                $exists: true
              }
            }
          },

          {
            $group: {

              _id: {

                $toLower:
                  "$sections.section"
              },

              section: {

                $first:
                  "$sections"
              }
            }
          },

          {
            $project: {

              _id: 0,

              section: 1
            }
          },

          {
            $sort: {
              section: 1
            }
          }
        ]);

      res.json({

        success: true,

        data: sections
      });

    } catch (err) {

      console.error(
        "❌ Sections Error:",
        err
      );

      res.status(500).json({
        success: false
      });
    }
  }
);

