// =====================================================
// 🔥 4. POINTS OF LAW
// =====================================================

router.get(

  "/points",

  async (req, res) => {

    try {

      const {
        act,
        section
      } = req.query;

      const match: any = {

        ...VALID_JUDGMENT_FILTER,

        actNames: {

          $regex:
            escapeRegex(
              act as string
            ),

          $options: "i"
        }
      };

      if (section) {

        match[
          "sections.section"
        ] = {

          $regex:
            escapeRegex(
              section as string
            ),

          $options: "i"
        };
      }

      const results =
        await Judgment.find(match)

          .select(`

            _id
            pointsOfLaw
            headnote
            citation
            category
            caseNumber

          `)

          .limit(100)

          .lean();

      const data =
        results.map((r: any) => ({

          point:

            typeof r?.pointsOfLaw?.[0]
            === "string"
               ? r?.pointsOfLaw?.[0]
               : r?.pointsOfLaw?.[0]?.point
                 || "Unknown",

          headnote:
            r?.headnote || "",

          citation:
            r?.citation || "",

          category:
            r?.category || "",

          caseNumber:
            r?.caseNumber || "",

          judgmentId:
            r?._id
        }));

      res.json({

        success: true,

        data
      });

    } catch (err) {

      console.error(
        "❌ Points Error:",
        err
      );

      res.status(500).json({
        success: false
      });
    }
  }
);

