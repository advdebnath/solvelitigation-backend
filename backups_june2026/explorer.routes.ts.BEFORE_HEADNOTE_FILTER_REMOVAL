// =====================================================
// 🔥 5. HEADNOTES
// =====================================================

router.get(

  "/headnotes",

  async (req, res) => {

    try {

      const {

        act,
        section,
        point,
          category,
        page = 1

      } = req.query;

      const limit = 20;

      const skip =
        (Number(page) - 1)
        * limit;

      const match: any = {

        ...VALID_JUDGMENT_FILTER
      };

        if (category) {

          match.category = category;
        }

      if (act) {

        match.actNames = {

          $regex:
            escapeRegex(
              act as string
            ),

          $options: "i"
        };
      }

      if (section) {

        match[
          "sections.section"
        ] = {

          $regex:
            escapeRegex(
              section as string
            ),

          $options: "i"
        };
      }

      if (point) {

        match[
          "pointsOfLaw.point"
        ] = {

          $regex:
            escapeRegex(
              point as string
            ),

          $options: "i"
        };
      }

      const headnotes =
        await Judgment.find(match)

          .select(`

            _id
            citation
            headnote
            category
            caseNumber
            judgmentDate

          `)

          .sort({
            createdAt: -1
          })

          .skip(skip)

          .limit(limit)

          .lean();

      res.json({

        success: true,

        page:
          Number(page),

        data: headnotes
      });

    } catch (err) {

      console.error(
        "❌ Headnotes Error:",
        err
      );

      res.status(500).json({
        success: false
      });
    }
  }
);

