    } catch (err) {

      console.error(
        "❌ Judgment Error:",
        err
      );

      res.status(500).json({
        success: false
      });
    }
  }
);

// =====================================================
// 🔥 7. SIMILAR CASES
// =====================================================

router.get(

  "/similar/:id",

  async (req, res) => {

    try {

      const id =
        req.params.id;

      const current: any =
        await Judgment
          .findById(id)
          .lean();

      if (

        !current ||
        !current.embedding

      ) {

        return res.json({

          success: true,

          data: []
        });
      }

      const judgments: any[] =
        await Judgment.find({

          ...VALID_JUDGMENT_FILTER,

          _id: {
            $ne: id
          },

          embedding: {
            $exists: true
          }
        })

        .limit(200)

        .lean();

      const cosine = (
        a: number[],
        b: number[]
      ) => {

        let dot = 0;

        let normA = 0;

        let normB = 0;

        for (
          let i = 0;
          i < a.length;
          i++
        ) {

          dot +=
            a[i] * b[i];

          normA +=
            a[i] * a[i];

          normB +=
            b[i] * b[i];
        }

        return dot / (

          Math.sqrt(normA)
          *
          Math.sqrt(normB)

        );
      };

      const results =
        judgments

          .filter(
            j => j.embedding
          )

          .map((j: any) => ({

            id: j._id,

            caseNumber:
              j.caseNumber,

            category:
              j.category,

            headnote:
              j.headnote,

            score:
              cosine(

                current.embedding,

                j.embedding
              )
          }))

          .sort(
            (a, b) =>
              b.score - a.score
          )

          .slice(0, 5);

      res.json({

        success: true,

        data: results
      });

    } catch (err) {

      console.error(
        "❌ Similar Error:",
        err
      );

      res.status(500).json({
        success: false
      });
    }
  }
);

// =====================================================
// 🔥 8. ARGUMENT BUILDER
// =====================================================

router.post(

  "/argument",

  async (req, res) => {

    try {

      const { query } =
        req.body;

      if (!query) {

        return res
          .status(400)
          .json({
            success: false
          });
      }

      const results =
        await Judgment.find({

          ...VALID_JUDGMENT_FILTER,

          $or: [

            {
              headnote: {

                $regex: query,

                $options: "i"
              }
            },

            {
              pointsOfLaw: {

                $regex: query,

                $options: "i"
              }
            }
          ]
        })

        .select(`

          caseNumber
          headnote
          category

        `)

        .limit(5)

        .lean();

      const argument =
        results.map(
          (r: any) =>

          `In ${r.caseNumber}, it was held that ${r.headnote}.`
        );

      res.json({

        success: true,

        argument
      });

    } catch (err) {

      console.error(
        "❌ Argument Error:",
        err
      );

      res.status(500).json({
        success: false
      });
    }
  }
);

// =====================================================
// 🔥 9. DEBUG FLOW VERIFIER
// =====================================================

router.get(

  "/debug-flow/:id",

  async (req, res) => {

    try {

      const id =
        req.params.id;

      if (

        !mongoose.Types
          .ObjectId
          .isValid(id)

      ) {

        return res
          .status(400)
          .json({

            success: false,

            message:
              "Invalid judgment id"
          });
      }

      const judgment: any =
        await Judgment.findById(id)

          .select(`

            caseNumber
            category
            actNames
            sections
            pointsOfLaw
            headnote
            judgmentDate
            judges
            parties
            citation

          `)

          .lean();

      if (!judgment) {

        return res
          .status(404)
          .json({

            success: false,

            message:
              "Judgment not found"
          });
      }

      const validation = {

        category:
          !!judgment.category,

        acts:

          Array.isArray(
            judgment.actNames
          )
          &&
          judgment.actNames.length > 0,

        sections:

          Array.isArray(
            judgment.sections
          )
          &&
          judgment.sections.length > 0,

        points:

          Array.isArray(
            judgment.pointsOfLaw
          )
          &&
          judgment.pointsOfLaw.length > 0,

        headnote:
          !!judgment.headnote,

        caseNumber:
          !!judgment.caseNumber,

        citation:
          !!judgment.citation
      };

      const explorerFlow = {

        categoryUrl:

          `/explorer/category/${encodeURIComponent(

            judgment.category || ""

          )}`,

        acts:
          (judgment.actNames || [])
          .map((a: string) => ({

            act: a,

            url:
             
              `/explorer/acts/${encodeURIComponent(a)}`
          })),

        sections:
          (judgment.sections || [])
          .map((s: any) => ({

            section:
              s?.section || "",

            act:
              s?.act || "",

            type:
              s?.type || "",

            url:
              `/explorer/sections/${encodeURIComponent(  
                s?.section || ""
              )}`
          })),

        points:
          (judgment.pointsOfLaw || [])
          .map((p: any) => ({

            point:

              typeof p === "string"

                ? p

                : p?.point || "",

            category:
              p?.category || "",

            url:
              `/explorer/point/${encodeURIComponent(

                typeof p === "string"

                  ? p

                  : p?.point || ""

              )}`
          })),

        judgmentUrl:
          `/explorer/judgment/${id}`
      };

      res.json({

        success: true,

        validation,

        explorerFlow,

        judgment
      });

    } catch (err) {

      console.error(
        "❌ Debug Flow Error:",
        err
      );

      res.status(500).json({

        success: false,

        message:
          "Debug flow failed"
      });
    }
  }
);

