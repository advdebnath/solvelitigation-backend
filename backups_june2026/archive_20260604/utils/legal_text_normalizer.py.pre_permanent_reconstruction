# 🔥 LEGAL PROPOSITION + HOLDING EXTRACTION ENGINE
# =========================================================

LEGAL_PROPOSITION_PATTERNS = [

    r"it is held that",
    r"this court held that",
    r"we hold that",
    r"the law is well settled",
    r"it is settled law",
    r"the legal position is",
    r"it is clarified that",
    r"it is declared that",
    r"therefore[, ]+held",
    r"thus[, ]+held",
    r"in our considered opinion",
    r"the issue is answered",
    r"the court observed that",
    r"we are of the opinion that",
    r"the principle laid down",
    r"ratio decidendi",
    r"binding precedent",
    r"statutory interpretation",
    r"constitutional mandate",
    r"it is evident that"
]


def extract_legal_propositions(text):

    if not text:
        return []

    propositions = []

    normalized = str(text)

    sentences = re.split(
        r"(?<=[\.!?])\s+",
        normalized
    )

    for sentence in sentences:

        lower_sentence = sentence.lower().strip()

        if len(lower_sentence) < 40:
            continue

        score = 0

        for pattern in LEGAL_PROPOSITION_PATTERNS:

            if pattern in lower_sentence:
                score += 25

        if "section" in lower_sentence:
            score += 10

        if "article" in lower_sentence:
            score += 10

        if "constitution" in lower_sentence:
            score += 15

        if "held" in lower_sentence:
            score += 20

        if "interpretation" in lower_sentence:
            score += 15

        if "precedent" in lower_sentence:
            score += 15

        if score >= 30:

            propositions.append({
                "text": sentence.strip(),
                "score": score
            })

    propositions = sorted(
        propositions,
        key=lambda x: x["score"],
        reverse=True
    )

    return propositions[:25]


