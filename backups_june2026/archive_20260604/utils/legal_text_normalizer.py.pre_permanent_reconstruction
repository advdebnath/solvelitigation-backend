import re


# =========================================================
# 🔥 OCR HEADER / FOOTER POLLUTION PATTERNS
# =========================================================

HEADER_FOOTER_PATTERNS = [

    r"Downloaded\s+on\s*[:-].*",
    r"Page\s+\d+\s+of\s+\d+",
    r"\b\d+\s*$",
    r"https?://\S+",
    r"www\.\S+",
    r"Digitally\s+signed\s+by.*",
    r"This\s+document\s+has\s+been\s+digitally\s+signed.*",
    r":::\s*Uploaded\s+on.*",
    r"Signature\s+Not\s+Verified",
    r"Verified\s+Digitally",
    r"Uploading\s+Date.*",
    r"Download(ed)?\s+From.*",
    r"Neutral\s+Citation\s+No\.?\s*[:\-]?.*",
    r"Page\s*\d+",
    r"\bSUPREME\s+COURT\s+REPORTS\b",
    r"\bSCC\b",
    r"\bSCR\b",
    r"\bAIR\b",
    r"\bCriLJ\b",
    r"\bJUDIS\b",
    r"\bLiveLaw\b",
    r"\bBar\s+and\s+Bench\b",
    r"\bItem\s+No\.?\s*\d+",
    r"\bCourt\s+No\.?\s*\d+",
    r"\bSerial\s+No\.?\s*\d+",
]


def remove_header_footer_pollution(text):

    if not text:
        return ""

    cleaned = str(text)

    for pattern in HEADER_FOOTER_PATTERNS:

        cleaned = re.sub(
            pattern,
            " ",
            cleaned,
            flags=re.I
        )

    cleaned = re.sub(
        r"\n{2,}",
        "\n",
        cleaned
    )

    cleaned = re.sub(
        r"[ \t]{2,}",
        " ",
        cleaned
    )

    return cleaned.strip()


# =========================================================
# 🔥 LEGAL CITATION NORMALIZATION ENGINE
# =========================================================

CITATION_PATTERNS = {

    r"\bAIR\s*(\d{4})\s*SC\s*(\d+)\b":
        r"AIR \1 SC \2",

    r"\bAIR\s*(\d{4})\s*([A-Z][a-zA-Z]+)\s*(\d+)\b":
        r"AIR \1 \2 \3",

    r"\b\((\d{4})\)\s*(\d+)\s*SCC\s*(\d+)\b":
        r"(\1) \2 SCC \3",

    r"\b\((\d{4})\)\s*(\d+)\s*SCR\s*(\d+)\b":
        r"(\1) \2 SCR \3",

    r"\b(\d{4})\s*SCC\s*OnLine\s*SC\s*(\d+)\b":
        r"\1 SCC OnLine SC \2",

    r"\b(\d{4})\s*SCC\s*OnLine\s*Del\s*(\d+)\b":
        r"\1 SCC OnLine Del \2",

    r"\b(\d{4})\s*CriLJ\s*(\d+)\b":
        r"\1 CriLJ \2",

    r"\bMANU/[A-Z]{2}/\d{4}/\d+\b":
        lambda m: m.group(0).upper(),

    r"\bNeutral\s+Citation\s+No\.?\s*[:\-]?\s*([A-Z0-9:\-/]+)":
        r"Neutral Citation No. \1"
}


def normalize_legal_citations(text):

    if not text:
        return ""

    normalized = str(text)

    for pattern, replacement in CITATION_PATTERNS.items():

        normalized = re.sub(
            pattern,
            replacement,
            normalized,
            flags=re.I
        )

    normalized = re.sub(
        r"\s{2,}",
        " ",
        normalized
    )

    return normalized.strip()


# =========================================================
# 🔥 PARTY NAME + CASE TITLE RECONSTRUCTION ENGINE
# =========================================================

PARTY_NAME_REPAIRS = {

    r"\bversu[s5]\b":
        "versus",

    r"\bv[\./]s[\./]?\b":
        "versus",

    r"\bpeti\s*tioner[s]?\b":
        "petitioner",

    r"\brespon\s*dent[s]?\b":
        "respondent",

    r"\bappel\s*lant[s]?\b":
        "appellant",

    r"\baccu\s*sed\b":
        "accused",

    r"\bstate\s+of\s+([A-Z][a-z]+)\b":
        lambda m: f"State of {m.group(1)}",

    r"\bunion\s+of\s+india\b":
        "Union of India",

    r"\bhigh\s+cour[t]?\s+of\s+([A-Z][a-zA-Z\s]+)\b":
        lambda m: f"High Court of {m.group(1).strip()}",

    r"\bsupreme\s+cour[t]?\s+of\s+india\b":
        "Supreme Court of India",

    r"\bthrough\s+its\s+.*?\b":
        "through its authorized representative"
}


def normalize_party_and_case_titles(text):

    if not text:
        return ""

    normalized = str(text)

    for pattern, replacement in PARTY_NAME_REPAIRS.items():

        normalized = re.sub(
            pattern,
            replacement,
            normalized,
            flags=re.I
        )

    # -----------------------------------------------------
    # 🔥 FIX BROKEN VERSUS LINES
    # -----------------------------------------------------

    normalized = re.sub(
        r"\b([A-Z][A-Za-z0-9\.,&\-\s]+)\s+v(?:ersu[s5]|s\.?)\s+([A-Z][A-Za-z0-9\.,&\-\s]+)",
        r"\1 versus \2",
        normalized,
        flags=re.I
    )

    # -----------------------------------------------------
    # 🔥 REMOVE DUPLICATE PARTY LABELS
    # -----------------------------------------------------

    normalized = re.sub(
        r"\b(petitioner|respondent|appellant|accused)\s+\1\b",
        r"\1",
        normalized,
        flags=re.I
    )

    normalized = re.sub(
        r"\s{2,}",
        " ",
        normalized
    )

    return normalized.strip()


