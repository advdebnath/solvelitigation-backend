def differentiate_ratio_obiter(text):

    if not text:
        return {
            "ratio": [],
            "obiter": []
        }

    ratio_sentences = []

    obiter_sentences = []

    normalized = str(text)

    sentences = re.split(
        r"(?<=[\.!?])\s+",
        normalized
    )

    for sentence in sentences:

        lower_sentence = sentence.lower().strip()

        if len(lower_sentence) < 40:
            continue

        ratio_score = 0
        obiter_score = 0

        for hint in RATIO_HINTS:

            if hint in lower_sentence:
                ratio_score += 25

        for hint in OBITER_HINTS:

            if hint in lower_sentence:
                obiter_score += 25

        if "section" in lower_sentence:
            ratio_score += 10

        if "article" in lower_sentence:
            ratio_score += 10

        if "constitution" in lower_sentence:
            ratio_score += 15

        if "held" in lower_sentence:
            ratio_score += 15

        if "interpretation" in lower_sentence:
            ratio_score += 10

        if "disposed" in lower_sentence:
            ratio_score += 10

        if "may" in lower_sentence:
            obiter_score += 10

        if "possible" in lower_sentence:
            obiter_score += 10

        if "appears" in lower_sentence:
            obiter_score += 10

        if ratio_score >= obiter_score and ratio_score >= 30:

            ratio_sentences.append({
                "text": sentence.strip(),
                "score": ratio_score
            })

        elif obiter_score > ratio_score and obiter_score >= 25:

            obiter_sentences.append({
                "text": sentence.strip(),
                "score": obiter_score
            })

    ratio_sentences = sorted(
        ratio_sentences,
        key=lambda x: x["score"],
        reverse=True
    )

    obiter_sentences = sorted(
        obiter_sentences,
        key=lambda x: x["score"],
        reverse=True
    )

    return {
        "ratio": ratio_sentences[:20],
        "obiter": obiter_sentences[:20]
    }


