def detect_precedent_reliability(text):

    if not text:
        return {

            "precedent_status": [],

            "overall_reliability": "UNKNOWN"
        }

    normalized = str(text).lower()

    detected_statuses = []

    reliability_score = 50

    for status_name, keywords in PRECEDENT_STATUS_PATTERNS.items():

        score = 0

        matched_keywords = []

        for keyword in keywords:

            if keyword.lower() in normalized:

                score += 20

                matched_keywords.append(keyword)

        if score > 0:

            detected_statuses.append({

                "status": status_name,

                "score": score,

                "matched_keywords": matched_keywords
            })

            if status_name == "affirmed":
                reliability_score += 20

            elif status_name == "distinguished":
                reliability_score -= 5

            elif status_name == "doubted":
                reliability_score -= 25

            elif status_name == "partially_overruled":
                reliability_score -= 35

            elif status_name == "overruled":
                reliability_score = 0

    reliability_score = max(
        0,
        min(reliability_score, 100)
    )

    overall_reliability = "HIGH"

    if reliability_score <= 20:
        overall_reliability = "OVERRULED"

    elif reliability_score <= 40:
        overall_reliability = "WEAKENED"

    elif reliability_score <= 60:
        overall_reliability = "MODERATE"

    return {

        "precedent_status":
            detected_statuses,

        "reliability_score":
            reliability_score,

        "overall_reliability":
            overall_reliability
    }


