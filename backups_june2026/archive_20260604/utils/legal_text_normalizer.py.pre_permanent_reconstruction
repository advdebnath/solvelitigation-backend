# =========================================================

def stitch_broken_tokens(text):

    if not text:
        return ""

    repaired = str(text)

    for broken, fixed in OCR_REPAIR_MAP.items():

        repaired = re.sub(
            re.escape(broken),
            fixed,
            repaired,
            flags=re.I
        )

    # -----------------------------------------------------
    # 🔥 SEMANTIC PARAGRAPH CONTINUITY ENGINE
    # -----------------------------------------------------

    repaired = re.sub(
        r"(?<=[a-z,])\n(?=[a-z])",
        " ",
        repaired
    )

    repaired = re.sub(
        r"(?<=[a-z])\n(?=and\b|or\b|but\b|because\b)",
        " ",
        repaired,
        flags=re.I
    )

    repaired = re.sub(
        r"(?<=\w)-\s*\n\s*(?=\w)",
        "",
        repaired
    )

    repaired = re.sub(
        r"(?<=[a-z])\s*\n\s*(?=[a-z])",
        " ",
        repaired
    )

    repaired = re.sub(
        r"(?<=\.)\n(?=[a-z])",
        " ",
        repaired
    )

    repaired = re.sub(
        r"(?<=\w)\n(?=\w)",
        " ",
        repaired
    )

    repaired = re.sub(
        r"\n{2,}",
        "\n",
        repaired
    )

    # -----------------------------------------------------
    # 🔥 DUPLICATE OCR SENTENCE COLLAPSE
    # -----------------------------------------------------

    seen_lines = set()

    cleaned_lines = []

    for line in repaired.split("\n"):

        normalized = line.strip().lower()

        if (
            normalized
            and normalized not in seen_lines
        ):
            cleaned_lines.append(line.strip())
            seen_lines.add(normalized)

    repaired = "\n".join(cleaned_lines)

    # -----------------------------------------------------
    # 🔥 MULTI-SPACE CLEANUP
    # -----------------------------------------------------

    repaired = re.sub(
        r"\s+",
        " ",
        repaired
    )

    return repaired.strip()


