import logger from "../../utils/logger";
import { Request, Response } from "express";
import mongoose from "mongoose";
import JudgmentIngestion from "../../models/JudgmentIngestion";
import Judgment from "../../models/judgment.model";
import { io } from "../../server";
import { invalidateJudgmentCache } from "../../utils/cacheInvalidation";

export const nlpCallbackController = async (
  req: Request,
  res: Response
) => {
  try {
    const {
      ingestionId,
      status,
      error,
      summary,
      category,
      subCategory,
      pointsOfLaw,
      confidence,
    } = req.body;

    if (!mongoose.Types.ObjectId.isValid(ingestionId)) {
      return res.status(400).json({ message: "Invalid ingestionId" });
    }

    const ingestion = await JudgmentIngestion.findById(ingestionId);

    if (!ingestion) {
      return res.status(404).json({ message: "Ingestion not found" });
    }

    /* -------------------------------------------------------
       FAILURE HANDLING
    -------------------------------------------------------- */
    if (status === "FAILED") {
      ingestion.retryCount = (ingestion.retryCount || 0) + 1;

      if (ingestion.retryCount >= 3) {
        ingestion.status = "PERMANENT_FAILURE";
        ingestion.permanentFailureAt = new Date();
        logger.info("🚨 Permanent failure:", ingestionId);
      } else {
        ingestion.status = "QUEUED";
        logger.info("🔁 Re-queued for retry:", ingestionId);
      }

      ingestion.error = error || "NLP processing failed";
      ingestion.failedAt = new Date();

      await ingestion.save();

      io.emit("nlp-update", {
        ingestionId,
        status: ingestion.status,
      });

      return res.json({
        success: true,
        ingestionId,
        retryCount: ingestion.retryCount,
        status: ingestion.status,
      });
    }

    /* -------------------------------------------------------
       SUCCESS HANDLING
    -------------------------------------------------------- */
    if (status === "COMPLETED") {
      ingestion.status = "COMPLETED";
      ingestion.completedAt = new Date();
      await ingestion.save();

      const judgment = await Judgment.findOne({
        ingestionId: new mongoose.Types.ObjectId(ingestionId),
      });

      if (judgment) {
        await Judgment.updateOne(
          { _id: judgment._id },
          {
            $set: {
              summary,
              category,
              subCategory,
              pointsOfLaw: Array.isArray(pointsOfLaw)
                ? pointsOfLaw
                : [],
              confidence,
              nlpStatus: "COMPLETED",
            },
          },
          { runValidators: false }
        );

        /* ---------------- CACHE INVALIDATION ---------------- */
        await invalidateJudgmentCache();
      }

      io.emit("nlp-update", {
        ingestionId,
        status: "COMPLETED",
        confidence,
      });

      return res.json({
        success: true,
        ingestionId,
        status: "COMPLETED",
      });
    }

    return res.status(400).json({ message: "Invalid status" });

  } catch (err) {
    logger.error("❌ NLP callback error:", err);
    return res.status(500).json({ message: "Callback failed" });
  }
};
