import { Request, Response } from "express";
import JudgmentIngestion from "../../models/JudgmentIngestion";
import Judgment from "../../models/judgment.model";
import { io } from "../../server";

export const nlpCallbackController = async (
  req: Request,
  res: Response
): Promise<Response> => {
  try {
    const { ingestionId, status, result, error } = req.body;

    console.log("📥 NLP Callback received:", {
      ingestionId,
      status,
    });

    // ------------------------------
    // Basic validation
    // ------------------------------
    if (!ingestionId || !status) {
      return res.status(400).json({
        success: false,
        message: "Invalid callback payload",
      });
    }

    // ------------------------------
    // Fetch ingestion
    // ------------------------------
    const ingestion = await JudgmentIngestion.findById(ingestionId);

    if (!ingestion) {
      return res.status(404).json({
        success: false,
        message: "Ingestion not found",
      });
    }

    // Prevent duplicate processing
    if (ingestion.status === "COMPLETED") {
      return res.status(200).json({
        success: true,
        message: "Already completed",
      });
    }

    // ------------------------------
    // PROCESSING
    // ------------------------------
    if (status === "PROCESSING") {
      ingestion.status = "PROCESSING";
      await ingestion.save();

      io.emit("ingestion-status-updated", {
        ingestionId,
        status: "PROCESSING",
        retryCount: ingestion.retryCount,
      });

      return res.status(200).json({
        success: true,
        message: "Marked as PROCESSING",
      });
    }

    // ------------------------------
    // COMPLETED
    // ------------------------------
    if (status === "COMPLETED") {
      ingestion.status = "COMPLETED";
      ingestion.completedAt = new Date();
      await ingestion.save();

      const existingJudgment = await Judgment.findOne({
        ingestionId: ingestion._id,
      });

      if (!existingJudgment) {
        await Judgment.create({
          ingestionId: ingestion._id,
          htmlContent: result?.htmlContent || "",
          metadata: result?.metadata || {},
          category: result?.category || "Uncategorized",
        });
      }

      io.emit("ingestion-status-updated", {
        ingestionId,
        status: "COMPLETED",
        retryCount: ingestion.retryCount,
      });

      return res.status(200).json({
        success: true,
        message: "Marked as COMPLETED",
      });
    }

    // ------------------------------
    // FAILED
    // ------------------------------
    if (status === "FAILED") {
      ingestion.status = "FAILED";
      ingestion.error = error || "Unknown NLP failure";
      await ingestion.save();

      io.emit("ingestion-status-updated", {
        ingestionId,
        status: "FAILED",
        retryCount: ingestion.retryCount,
      });

      return res.status(200).json({
        success: true,
        message: "Marked as FAILED",
      });
    }

    return res.status(400).json({
      success: false,
      message: "Invalid status value",
    });

  } catch (err) {
    console.error("❌ NLP Callback Error:", err);

    return res.status(500).json({
      success: false,
      message: "Internal server error",
    });
  }
};
