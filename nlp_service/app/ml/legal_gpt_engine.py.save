client = MongoClient(MONGO_URI)
db = client["solvelitigation"]

model = SentenceTransformer("all-MiniLM-L6-v2")

    query_vec = model.encode([query])[0]

    judgments = list(db.judgments.find({
        "embedding": {"$exists": True}
    }))

    if not judgments:
        return []

    vectors = np.array([j["embedding"] for j in judgments]).astype("float32")

    index = faiss.IndexFlatL2(vectors.shape[1])
    index.add(vectors)

    D, I = index.search(np.array([query_vec]).astype("float32"), k=3)

    return [judgments[i] for i in I[0]]

def generate_legal_response(query):
    similar_cases = search_similar_cases(query)

    if not similar_cases:
        return {"answer": "No relevant cases found"}

    context = ""
    for case in similar_cases:
        context += f"\nCase: {case.get('caseNumber')}\n"
        context += f"Category: {case.get('category')}\n"
        context += f"Points: {case.get('pointsOfLaw')}\n"
        context += f"Headnote: {case.get('headnote')}\n"

    # 🔥 SIMPLE LEGAL REASONING (BASE VERSION)
    answer = f"""
LEGAL ANALYSIS:

Based on similar cases:

{context}

CONCLUSION:
The issue appears to relate to {similar_cases[0].get('category')}.
The reasoning from above cases suggests a consistent legal interpretation.

ARGUMENT:
The strongest argument is derived from the cited cases where courts have interpreted similar issues in a structured manner.

"""

    return {
        "query": query,
        "answer": answer,
        "cases_used": [c.get("caseNumber") for c in similar_cases]
    }
