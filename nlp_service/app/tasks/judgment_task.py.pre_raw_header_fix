# =====================================================
# 🔥 SAFE LEGAL ABBREVIATION PROTECTION
# =====================================================

LEGAL_ABBREVIATIONS = [
    "J.",
    "No.",
    "Nos.",
    "Ltd.",
    "Pvt.",
    "SCC.",
    "AIR.",
    "Cri.",
    "Crl.",
    "W.P.",
    "Dr.",
    "Mr.",
    "Mrs.",
    "Hon."
]

def protect_legal_abbreviations(text):
    protected = {}

    for idx, abbr in enumerate(LEGAL_ABBREVIATIONS):
        token = f"__ABBR_{idx}__"
        protected[token] = abbr
        text = text.replace(abbr, token)

    return text, protected

def restore_legal_abbreviations(text, protected):
    for token, abbr in protected.items():
        text = text.replace(token, abbr)

    return text

