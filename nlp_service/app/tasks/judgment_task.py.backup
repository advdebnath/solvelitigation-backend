import hashlib
import html
import fitz
import re
from gridfs import GridFS
from datetime import datetime
from bson import ObjectId

from app.celery_app import celery_app
from app.db.mongo import get_db


@celery_app.task(
    bind=True,
    autoretry_for=(Exception,),
    retry_kwargs={"max_retries": 3, "countdown": 5},
    retry_backoff=True,
    retry_jitter=True,
    name="app.tasks.judgment_task.process_judgment",
)
def process_judgment(self, ingestion_id: str):

    from app.db.repositories import get_ingestion_by_id, update_ingestion_status

    db = get_db()

    # 🔄 Mark processing
    update_ingestion_status(ingestion_id, status="PROCESSING")

    ingestion = get_ingestion_by_id(ingestion_id)
    original_name = ingestion["file"]["originalName"]

    fs = GridFS(db, collection="uploads")
    grid_file = fs.find_one({"filename": original_name})

    if not grid_file:
        update_ingestion_status(
            ingestion_id,
            status="FAILED",
            error="PDF not found in GridFS",
        )
        raise FileNotFoundError("PDF not found in GridFS")

    try:
        pdf_bytes = grid_file.read()
        doc = fitz.open(stream=pdf_bytes, filetype="pdf")

        full_text = ""
        html_pages = []
        toc_entries = []
        heading_counter = 0

        for page_index, page in enumerate(doc, start=1):

            page_dict = page.get_text("dict")
            page_html = []

            for block in page_dict["blocks"]:
                if block["type"] != 0:
                    continue

                for line in block["lines"]:

                    line_text = ""
                    max_font_size = 0
                    is_bold = False

                    for span in line["spans"]:
                        text = span["text"].strip()
                        if not text:
                            continue

                        line_text += text + " "
                        max_font_size = max(max_font_size, span["size"])

                        if "Bold" in span.get("font", ""):
                            is_bold = True

                    line_text = line_text.strip()
                    if not line_text:
                        continue

                    escaped = html.escape(line_text)
                    full_text += line_text + "\n"

                    # 🔎 Improved Heading Detection
                    is_paragraph_number = re.match(r"^\d+\.$", line_text)
                    is_short_upper = line_text.isupper() and len(line_text.split()) <= 8
                    is_rule_heading = line_text.strip().startswith("Rule ")
                    is_annexure = line_text.strip().startswith("Annexure")

                    if (
                        not is_paragraph_number
                        and (
                            is_short_upper
                            or is_rule_heading
                            or is_annexure
                        )
                    ):
                        heading_counter += 1
                        heading_id = f"heading-{heading_counter}"

                        page_html.append(
                            f'<h2 id="{heading_id}">{escaped}</h2>'
                        )

                        toc_entries.append(
                            f'<li><a href="#{heading_id}">{escaped}</a></li>'
                        )
                    else:
                        page_html.append(f"<p>{escaped}</p>")

            html_pages.append(
                f'<section class="page" data-page="{page_index}">'
                + "".join(page_html)
                + "</section>"
            )

        doc.close()

        toc_html = (
            '<nav class="toc"><h2>Table of Contents</h2><ul>'
            + "".join(toc_entries)
            + "</ul></nav>"
        )

        html_content = (
            "<html><body>"
            + toc_html
            + '<article class="judgment">'
            + "".join(html_pages)
            + "</article></body></html>"
        )

        page_count = len(html_pages)
        text_length = len(full_text)
        checksum = hashlib.sha256(pdf_bytes).hexdigest()

    except Exception as e:
        update_ingestion_status(
            ingestion_id,
            status="FAILED",
            error=str(e),
        )
        raise

    ingestion_obj_id = ObjectId(ingestion_id)

    # 🔒 Prevent duplicate judgment creation
    existing = db["judgments"].find_one(
        {"ingestionId": ingestion_obj_id},
        {"_id": 1},
    )

    if existing:
        judgment_id = existing["_id"]

        db["judgments"].update_one(
            {"_id": judgment_id},
            {
                "$set": {
                    "htmlContent": html_content,
                    "pageCount": page_count,
                    "textLength": text_length,
                    "checksum": checksum,
                    "nlpStatus": "COMPLETED",
                    "updatedAt": datetime.utcnow(),
                }
            },
        )
    else:
        result = db["judgments"].insert_one(
            {
                "ingestionId": ingestion_obj_id,
                "htmlContent": html_content,
                "pageCount": page_count,
                "textLength": text_length,
                "checksum": checksum,
                "nlpStatus": "COMPLETED",
                "createdAt": datetime.utcnow(),
                "updatedAt": datetime.utcnow(),
            }
        )

        judgment_id = result.inserted_id

    db["judgmentingestions"].update_one(
        {"_id": ingestion_obj_id},
        {
            "$set": {
                "judgmentId": judgment_id,
                "status": "COMPLETED",
                "error": None,
                "updatedAt": datetime.utcnow(),
            }
        },
    )

    return {
        "ingestionId": ingestion_id,
        "status": "COMPLETED",
        "pageCount": page_count,
        "textLength": text_length,
        "checksum": checksum,
    }
