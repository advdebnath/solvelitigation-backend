@celery_app.task(
    name="app.tasks.judgment_task.process_judgment"
)
def process_judgment(ingestion_id):

    db = get_db()

    try:

        ingestion = db.judgmentingestions.find_one({

            "_id": ObjectId(
                ingestion_id
            )
        })

        if not ingestion:

            print(
                "❌ Ingestion not found:",
                ingestion_id
            )

            return

        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================
        # 🔥 PROCESSING STATUS
        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================

        db.judgmentingestions.update_one(

            {
                "_id": ObjectId(
                    ingestion_id
                )
            },

            {
                "$set": {

                    "status": "PROCESSING",

                    "stage": "EXTRACTING",

                    "progress": 10,

                    "processingAt":
                        datetime.utcnow()
                }
            }
        )

        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================
        # 🔥 FILE PATH
        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================

        file_path = os.path.join(

            BASE_PATH,

            ingestion["file"]["relativePath"]
        )

        print(
            "📂 Processing:",
            file_path
        )

        if not os.path.exists(file_path):

            raise Exception(
                f"File not found: {file_path}"
            )

        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================
        # 🔥 HTML CONVERSION
        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================

        raw_html = convert_pdf_to_html(
            file_path
        )

        html_data = parse_html_document(
            raw_html
        )

        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================
        # 🔥 PAGE EXTRACTION
        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================

        pages = extract_pages(
            file_path
        )

        if not pages:

            raise Exception(
                "No pages extracted"
            )

        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================
        # 🔥 SEMANTIC PARAGRAPH ENGINE
        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================

        semantic_data = build_semantic_paragraphs(
            pages
        )

        semantic_paragraphs = semantic_data.get(
            "paragraphs",
            []
        )

        print("\n🔥 SEMANTIC PARAGRAPH SAMPLE START\n")

        for idx, para in enumerate(semantic_paragraphs[:20]):

            print(f"\n========== PARA {idx+1} ==========\n")

            print(str(para)[:3000])

        print("\n🔥 SEMANTIC PARAGRAPH SAMPLE END\n")

        semantic_headings = semantic_data.get(
            "headings",
            []
        )

        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================
        # 🔥 PRIMARY SEMANTIC TEXT
        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================

        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================
        # 🔥 PRIMARY SEMANTIC TEXT
        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================

        semantic_text = "\n\n".join(
            [
                str(p)
                for p in pages
                if p and isinstance(p, str)
            ]
        )

        # -----------------------------------------------------
        # 🔥 SEMANTIC ENRICHMENT
        # -----------------------------------------------------

        if semantic_paragraphs:

            semantic_text += "\n\n" + "\n\n".join(
