def normalize_text(text):

    if not text:

        return ""

    text = unicodedata.normalize(
        "NFKC",
        text
    )

    text = text.replace("\x0c", " ")

    text = text.replace("\r", " ")

    text = text.replace("\t", " ")

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()

