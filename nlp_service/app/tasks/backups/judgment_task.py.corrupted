            print(str(e))

        # =====================================================
        # 🔥 VALIDATION

        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================

            # 🔥 FULL TEXT NORMALIZATION
        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

            # =====================================================


        if full_text is None:
            full_text = ""

        elif isinstance(full_text, dict):

            full_text = full_text.get(
                "text",
                ""
            )

        elif isinstance(full_text, list):

            full_text = " ".join(
                [
                    str(x)
                    for x in full_text
                ]
            )

        elif not isinstance(full_text, str):

            full_text = str(full_text)

        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================
        # 🔥 BASIC NORMALIZATION
        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================

        full_text = re.sub(
            r"[ \t]+",
            " ",
            full_text
        ).strip()

        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================
        # 🔥 REMOVE LEGAL HEADER POLLUTION
        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================

        full_text = re.sub(
            r'NON-REPORTABLE.*?JURISDICTION',
            ' ',
            full_text,
            flags=re.I | re.S
        )

        full_text = re.sub(
            r'IN THE SUPREME COURT OF INDIA',
            ' ',
            full_text,
            flags=re.I
        )

        full_text = re.sub(
            r'CRIMINAL APPEAL NO\.[^\n]+',
            ' ',
            full_text,
            flags=re.I
        )

        full_text = re.sub(
            r'CIVIL APPEAL NO\.[^\n]+',
            ' ',
            full_text,
            flags=re.I
        )

        full_text = re.sub(
            r'APPELLANT[S]?',
            ' ',
            full_text,
            flags=re.I
        )

        full_text = re.sub(
            r'RESPONDENT[S]?',
            ' ',
            full_text,
            flags=re.I
        )

        full_text = re.sub(
            r'VERSUS',
            ' ',
            full_text,
            flags=re.I
        )

        full_text = re.sub(
            r"\s+",
            " ",
            full_text
        ).strip()

        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================
        # 🔥 JURISPRUDENTIAL SENTENCE INTELLIGENCE
        except Exception as e:

            print("❌ Validation Normalization Error")
            print(str(e))

        # =====================================================

        jurisprudential_sentences = []


        try:

            raw_sentences = (
                extract_jurisprudential_sentences(
                    full_text
                )
            )

            for sent_obj in raw_sentences:

                sentence_text = sent_obj.get(
                    "text",
                    ""
                )

                role_result = (
                    classify_sentence_role(
                        sentence_text
                    )
                )

                weight_result = (
                    compute_sentence_weights(
                        role_result
                    )
                )

                enriched_sentence = {

                    **sent_obj,

                    "role_data": role_result,

                    "weight_data": weight_result,
                }

                jurisprudential_sentences.append(
                    enriched_sentence
                )

            print(
                "✅ JURISPRUDENTIAL SENTENCE INTELLIGENCE COMPLETE"
            )

            print(
                f"✅ SENTENCE COUNT: {len(jurisprudential_sentences)}"
            )

            if jurisprudential_sentences:

                print(
                    "✅ SAMPLE SENTENCE:"
                )

                print(
                    jurisprudential_sentences[0]
                )

        except Exception as e:

            print(
                "❌ JURISPRUDENTIAL SENTENCE ERROR:"
            )

            print(str(e))


        # -----------------------------------------------------

        if judges is None:
