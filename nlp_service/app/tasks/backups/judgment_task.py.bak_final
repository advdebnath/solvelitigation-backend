from app.celery_app import celery_app
from datetime import datetime
from bson import ObjectId
from pymongo import MongoClient
import os, re, subprocess
from bs4 import BeautifulSoup

BASE_PATH = "/var/www/solvelitigation/backend"
MONGO_URI = "mongodb://sl_app:Debnath%401966@127.0.0.1:27017/solvelitigation"

def get_db():
    return MongoClient(MONGO_URI)["solvelitigation"]

# --------------------------------------------------
# 🔹 TEXT CLEANING
# --------------------------------------------------

def normalize_text(text):
    return re.sub(r"\s+", " ", text).strip()

# --------------------------------------------------
# 🔹 PDF → HTML
# --------------------------------------------------

def convert_pdf_to_html(pdf, html):
    try:
        subprocess.run(["pdftohtml", "-c", "-hidden", pdf, html], check=True)
        return True
    except Exception as e:
        print("❌ HTML ERROR:", e)
        return False

# --------------------------------------------------
# 🔹 EXTRACT TEXT
# --------------------------------------------------

def extract_text(html_path):
    try:
        with open(html_path, "r", encoding="utf-8", errors="ignore") as f:
             soup = BeautifulSoup(f, "html.parser")
             return normalize_text(soup.get_text(" "))
    except Exception as e:
        print("❌ TEXT ERROR:", e)
        return ""

# --------------------------------------------------
# 🔹 CASE NUMBER
# --------------------------------------------------

def extract_case_number(text):
    patterns = [
        r"CIVIL APPEAL NO\.?\s*\d+ OF \d+",
        r"CRIMINAL APPEAL NO\.?\s*\d+ OF \d+",
        r"SLP\s*\(.*?\).*?\d+ OF \d+",
        r"WRIT PETITION.*?\d+ OF \d+",
    ]
    for p in patterns:
        m = re.search(p, text, re.IGNORECASE)
        if m:
             return m.group().strip()
    return ""

# --------------------------------------------------
# 🔹 COURT DETECTION (FIXED)
# --------------------------------------------------

def detect_court(text):
    t = text.upper()

    if "SUPREME COURT OF INDIA" in t:
        return "SUPREME COURT OF INDIA"

    if "HIGH COURT" in t:
        return "HIGH COURT"

    if "TRIBUNAL" in t:
        return "TRIBUNAL"

    return "OTHER"

# --------------------------------------------------
# 🔹 CATEGORY
# --------------------------------------------------

def classify_category(text):
    t = text.upper()

    if "CRIMINAL" in t:
        return "Criminal"

    if "SERVICE" in t or "DEPARTMENTAL" in t:
        return "Service"

    if "TAX" in t or "GST" in t:
        return "Taxation & Corporate"

    return "Civil"

# --------------------------------------------------
# 🔹 POINTS OF LAW (NEW)
# --------------------------------------------------

def extract_points(text):
    matches = re.findall(r"Section\s*\d+[A-Za-z]*", text, re.IGNORECASE)
    return list(set(matches))[:10]

# --------------------------------------------------
# 🔹 HEADNOTE (IMPROVED)
# --------------------------------------------------

def generate_headnote(text, category):
    snippet = text[:1200]

    return f"{category} Law – Extracted Issue – {snippet[:300]}..."

# --------------------------------------------------
# 🔥 MAIN TASK (FINAL)
# --------------------------------------------------

@celery_app.task(name="app.tasks.judgment_task.process_judgment")
def process_judgment(ingestion_id: str):
    db = get_db()

    try:
        print("🔥 NLP TASK STARTED:", ingestion_id)

        ingestion = db.judgmentingestions.find_one({"_id": ObjectId(ingestion_id)})

        if not ingestion:
            raise Exception("❌ Ingestion not found")

        file_path = os.path.join(BASE_PATH, ingestion["file"]["relativePath"])

        if not os.path.exists(file_path):
            raise Exception(f"❌ File not found: {file_path}")

        # STEP 1 → extract text
        text = extract_text(file_path)

        if not text:
            raise Exception("❌ Empty text")

        print("📄 TEXT LENGTH:", len(text))

        # STEP 2 → case number
        case_number = extract_case_number(text)

        # STEP 3 → classification
        category = classify_category(text)
        court = detect_court(text)

        # STEP 4 → points
        points = extract_points(text)

        # STEP 5 → headnote
        headnote = generate_headnote(text, category)

        # =========================================
        # 🔥 STEP 7 DUPLICATE SAFE
        # =========================================
        existing = db.judgments.find_one({"caseNumber": case_number})

        if existing:
            case_number = f"{case_number}_{ingestion_id}"
            print("⚠️ Duplicate detected →", case_number)

        # =========================================
        # 🔥 STEP 8 INSERT
        # =========================================
        insert_result = db.judgments.insert_one({
            "caseNumber": case_number,
            "category": category,
            "court": court,
            "headnote": headnote,
            "pointsOfLaw": points,
            "fullText": text,
            "createdAt": datetime.utcnow()
        })

        if not insert_result.inserted_id:
            raise Exception("❌ INSERT FAILED")

        print("✅ INSERTED:", insert_result.inserted_id)

        # =========================================
        # 🔥 STEP 9 COMPLETE
        # =========================================
        db.judgmentingestions.update_one(
            {"_id": ObjectId(ingestion_id)},
            {
                "$set": {
                    "status": "COMPLETED",
                    "stage": "COMPLETED",
                    "progress": 100,
                    "completedAt": datetime.utcnow(),
                    "nlpProcessed": True,
                    "isCompleted": True
                }
            }
        )

        print("✅ COMPLETED:", ingestion_id)

    except Exception as e:
        print("❌ TASK FAILED:", str(e))

        db.judgmentingestions.update_one(
            {"_id": ObjectId(ingestion_id)},
            {
                "$set": {
                    "status": "FAILED",
                    "stage": "FAILED",
                    "error": str(e),
                    "nlpProcessed": False
                }
            }
        )
