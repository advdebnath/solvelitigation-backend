from app.celery_app import celery_app
from datetime import datetime
from bson import ObjectId
from pymongo import MongoClient
import os, re
import fitz  # PyMuPDF

# =========================================
# CONFIG
# =========================================
BASE_PATH = "/var/www/solvelitigation/backend"
MONGO_URI = "mongodb://sl_app:Debnath%401966@127.0.0.1:27017/solvelitigation"

def get_db():
    return MongoClient(MONGO_URI)["solvelitigation"]

# =========================================
# TEXT EXTRACTION
# =========================================
def extract_text_from_pdf(pdf_path):
    try:
        doc = fitz.open(pdf_path)
        text = ""
        for page in doc:
            text += page.get_text()
        doc.close()
        return text.strip()
    except Exception as e:
        print("❌ TEXT EXTRACTION ERROR:", e)
        return ""

# =========================================
# CASE NUMBER
# =========================================
def extract_case_number(text):
    patterns = [
        r"CIVIL APPEAL NO\.?\s*\d+ OF \d+",
        r"CRIMINAL APPEAL NO\.?\s*\d+ OF \d+",
        r"SLP\s*\(.*?\).*?\d+ OF \d+",
        r"WRIT PETITION.*?\d+ OF \d+",
    ]
    for p in patterns:
        m = re.search(p, text, re.IGNORECASE)
        if m:
            return m.group().strip()
    return ""

# =========================================
# COURT
# =========================================
def detect_court(text):
    t = text.upper()
    if "SUPREME COURT OF INDIA" in t:
        return "SUPREME COURT OF INDIA"
    if "HIGH COURT" in t:
        return "HIGH COURT"
    if "TRIBUNAL" in t:
        return "TRIBUNAL"
    return "UNKNOWN COURT"

# =========================================
# CATEGORY
# =========================================
def classify_category(text):
    t = text.lower()

    if "criminal appeal" in t or "ipc" in t or "crpc" in t:
        return "Criminal"

    if "civil appeal" in t or "writ petition (civil)" in t:
        return "Civil"

    if "service matter" in t or "departmental proceeding" in t:
        return "Service"

    if "tax" in t or "assessment" in t or "gst" in t:
        return "Taxation & Corporate"

    if "wakf" in t or "tenancy" in t or "property" in t:
        return "Civil"

    return "Civil"

# =========================================
# HEADNOTE
# =========================================
def generate_headnote(text, category):
    t = text.lower()
    topics = []

    if "wakf" in t:
        topics.append("Wakf")

    if "tenant" in t or "tenancy" in t:
        topics.append("Tenancy")

    if "joint hindu family" in t:
        topics.append("Joint Hindu Family")

    if "karta" in t:
        topics.append("Karta Rights")

    if "jurisdiction" in t or "tribunal" in t:
        topics.append("Jurisdiction")

    if not topics:
        topics.append("General Legal Issue")

    topic_str = " – ".join(list(dict.fromkeys(topics))[:3])
    return f"{category} – {topic_str} – tenancy rights and jurisdiction clarified"

# =========================================
# POINTS
# =========================================
def extract_points(text):
    matches = re.findall(r"Section\s*\d+[A-Za-z]*", text, re.IGNORECASE)
    return list(set(matches))[:10]

# =========================================
# MAIN TASK
# =========================================
@celery_app.task(name="app.tasks.judgment_task.process_judgment")
def process_judgment(ingestion_id: str):
    db = get_db()

    try:
        print("🔥 NLP TASK STARTED:", ingestion_id)

        ingestion = db.judgmentingestions.find_one({"_id": ObjectId(ingestion_id)})
        if not ingestion:
            raise Exception("❌ Ingestion not found")

        pdf_path = os.path.join(BASE_PATH, ingestion["file"]["relativePath"])

        if not os.path.exists(pdf_path):
            raise Exception("❌ FILE NOT FOUND")

        text = extract_text_from_pdf(pdf_path)

        if not text or len(text) < 500:
            raise Exception("❌ TEXT EXTRACTION FAILED")

        print("📄 TEXT LENGTH:", len(text))

        case_number = extract_case_number(text)
        if not case_number:
            case_number = f"CASE_{ingestion_id}"

