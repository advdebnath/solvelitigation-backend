# =========================================================
# 🔥 DB
# =========================================================

def get_db():

    return mongo_client["solvelitigation"]

# =========================================================
# 🔥 NORMALIZE TEXT
# =========================================================

def normalize_text(text):

    if not text:

        return ""

    text = unicodedata.normalize(
        "NFKC",
        text
    )

    text = text.replace("\x0c", " ")

    text = text.replace("\r", " ")

    text = text.replace("\t", " ")

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text.strip()

# =========================================================
# 🔥 PDF → HTML
# =========================================================

def convert_pdf_to_html(pdf_path):

    try:

        subprocess.run(

            [
                "pdftohtml",
                "-noframes",
                "-stdout",
                pdf_path
            ],

            capture_output=True,

            text=True,

            check=True
        )

        result = subprocess.check_output(

            [
                "pdftohtml",
                "-noframes",
                "-stdout",
                pdf_path
            ],

            text=True
        )

        return result

    except Exception as e:

        print(
            "❌ HTML CONVERSION ERROR:",
            e
        )

        return ""

# =========================================================
# 🔥 PAGE EXTRACTION
# =========================================================

def extract_pages(pdf_path):

    try:

        import fitz

        doc = fitz.open(pdf_path)

        pages = []

        max_pages = min(
            len(doc),
            30
        )

        for page_num in range(max_pages):

            page = doc[page_num]

            page_text = page.get_text()

            pages.append(page_text)

        doc.close()

        return pages

    except Exception as e:

        print(
            "❌ PAGE EXTRACTION ERROR:",
            e
        )

        return []

# =========================================================
# 🔥 MAIN TASK
# =========================================================

@celery_app.task(
    name="app.tasks.judgment_task.process_judgment"
)
def process_judgment(ingestion_id):

    db = get_db()

    try:

        ingestion = db.judgmentingestions.find_one({

            "_id": ObjectId(
                ingestion_id
            )
        })

        if not ingestion:

            print(
                "❌ Ingestion not found:",
                ingestion_id
            )

            return

        # =====================================================
        # 🔥 PROCESSING STATUS
        # =====================================================

        db.judgmentingestions.update_one(

            {
                "_id": ObjectId(
                    ingestion_id
                )
            },

            {
                "$set": {

                    "status": "PROCESSING",

                    "stage": "EXTRACTING",

                    "progress": 10,

                    "processingAt":
                        datetime.utcnow()
                }
            }
        )

        # =====================================================
        # 🔥 FILE PATH
        # =====================================================

        file_path = os.path.join(

            BASE_PATH,

            ingestion["file"]["relativePath"]
        )

        print(
            "📂 Processing:",
            file_path
        )

        if not os.path.exists(file_path):

            raise Exception(
                f"File not found: {file_path}"
            )

        # =====================================================
        # 🔥 HTML CONVERSION
        # =====================================================

        raw_html = convert_pdf_to_html(
            file_path
        )

        html_data = parse_html_document(
            raw_html
        )

        # =====================================================
        # 🔥 PAGE EXTRACTION
        # =====================================================

        pages = extract_pages(
            file_path
        )

        if not pages:

            raise Exception(
                "No pages extracted"
            )

        # =====================================================
        # 🔥 SEMANTIC PARAGRAPH ENGINE
        # =====================================================

        semantic_data = build_semantic_paragraphs(
            pages
        )

        semantic_paragraphs = semantic_data.get(
            "paragraphs",
            []
        )

        semantic_headings = semantic_data.get(
            "headings",
            []
        )

        # =====================================================
        # 🔥 PRIMARY SEMANTIC TEXT
        # =====================================================

        if semantic_paragraphs:

            semantic_text = "\n\n".join(
                semantic_paragraphs
            )

        else:

            semantic_text = "\n".join(
                pages
            )

        # =====================================================
        # 🔥 RAW MULTILINE TEXT
        # =====================================================

        raw_full_text = semantic_text

        # =====================================================
        # 🔥 NORMALIZED SEARCH TEXT
        # =====================================================

        full_text = normalize_text(
            semantic_text
        )

        # =====================================================
        # 🔥 TEXT ZONES
        # =====================================================

        header_text = normalize_text(
            " ".join(pages[:2])
        )

        ending_text = normalize_text(
            " ".join(pages[-3:])
        )

        body_text = normalize_text(
            semantic_text[:120000]
        )

        print(
            "🧠 Semantic Paragraphs:",
            len(semantic_paragraphs)
        )

        # =====================================================
        # 🔥 CORE EXTRACTION
        # =====================================================

        case_number = extract_case_number(
            header_text
        )

        court_data = extract_court(
            header_text
        )

        parties = extract_parties(
            header_text
        )

        judges = extract_judges(
            file_path
        )

        # =============================================
        # 🔥 RAW MULTILINE DATE EXTRACTION
        # =============================================

        judgment_date = extract_judgment_date(
            raw_full_text
        )

        # =====================================================
        # 🔥 LEGAL INTELLIGENCE
        # =====================================================

        sections = extract_sections(
            body_text
        )

        acts = extract_hybrid_acts(

            body_text,

            sections
        )

        # =====================================================
        # 🔥 CANONICAL ACT NORMALIZATION
        # =====================================================

        normalized_acts = []

        for act in acts.get("acts", []):

            if isinstance(act, dict):

                value = (
                    act.get("act_name")
                    or act.get("act")
                    or act.get("name")
                )

                if value:

                    normalized_acts.append(
                        str(value).strip()
                    )

            elif isinstance(act, str):

                value = act.strip()

                if value:

                    normalized_acts.append(value)

        acts["acts"] = sorted(
            list(set(normalized_acts))
        )

        print("✅ Canonical Acts:")
        print(acts["acts"])

        print(
            "✅ Hybrid Acts Extracted:"
        )

        print(
            acts
        )

        # =====================================================
        # 🔥 SECTION → ACT MAPPING
        # =====================================================

        section_act_mapping = enrich_sections_with_acts(

            sections.get(
                "sections",
                []
            )
        )

        print(
            "✅ Section → Act Mapping:"
        )

        print(
            section_act_mapping
        )

        points_of_law = extract_points_of_law(
            body_text
        )


        # =====================================================
        # 🔥 LEGAL ISSUE CLUSTERING
        # =====================================================

        issue_data = cluster_legal_issues(
            full_text
        )


        # =====================================================
        # 🔥 OPERATIVE ORDER EXTRACTION
        # =====================================================

        operative_data = extract_operative_order(
