        # -----------------------------------------------------
        # 🔥 ACT BASED
        # -----------------------------------------------------

        try:

            final_category = infer_category_from_act(

                acts.get(
                    "acts",
                    []
                )
            )

        except Exception as e:

            print(
                "❌ ACT CATEGORY ERROR:",
                e
            )

        # -----------------------------------------------------
        # 🔥 SECTION BASED
        # -----------------------------------------------------

        if final_category in [

            None,
            "",
            "Unknown",
            "General"

        ]:

            try:

                final_category = infer_category_from_sections(

                    sections.get(
                        "sections",
                        []
                    )
                )

            except Exception as e:

                print(
                    "❌ SECTION CATEGORY ERROR:",
                    e
                )

        # -----------------------------------------------------
