        # -----------------------------------------------------

        if final_category in [

            None,
            "",
            "Unknown",
            "General"

        ]:

            point_category = points_of_law.get(
                "category",
                "Unknown"
            )

            if point_category not in [

                None,
                "",
                "Unknown",
                "General"

            ]:

                final_category = point_category

        # -----------------------------------------------------
        # 🔥 CASE NUMBER BASED
        # -----------------------------------------------------

        if final_category in [

            None,
            "",
            "Unknown",
            "General"

        ]:

            try:

                final_category = infer_category_from_case_number(

                    case_number.get(
                        "case_number",
                        ""
                    )
                )

            except Exception as e:

                print(
                    "❌ CASE CATEGORY ERROR:",
