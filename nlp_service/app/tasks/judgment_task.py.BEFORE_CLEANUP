def convert_pdf_to_html(pdf_path):

    try:

        subprocess.run(
            ["pdftohtml", "-noframes", "-stdout", pdf_path],
            capture_output=True,
            text=True,
            check=True,
        )

        result = subprocess.check_output(
            ["pdftohtml", "-noframes", "-stdout", pdf_path], text=True
        )

        return result

    except Exception as e:

        print("❌ HTML CONVERSION ERROR:", e)

        return ""


