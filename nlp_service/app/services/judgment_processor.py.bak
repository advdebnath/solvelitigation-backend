from pymongo import MongoClient
from bson import ObjectId
from datetime import datetime
import os, re, traceback
from bs4 import BeautifulSoup

MONGO_URI = "mongodb://sl_app:Debnath%401966@127.0.0.1:27017/solvelitigation"
BASE_PATH = "/var/www/solvelitigation/backend"

client = MongoClient(MONGO_URI)
db = client["solvelitigation"]

# ============================================
# 🔥 FINAL EXTRACTION ENGINE (FIXED)
# ============================================

def extract_text(pdf_path):
    try:
        base = pdf_path.replace(".pdf", "")

        possible_files = [
            base + ".html",
            base + "-1.html",
            base + "-2.html"
        ]

        html_path = None

        for f in possible_files:
            if os.path.exists(f):
                html_path = f
                break

        if not html_path:
            print("❌ HTML NOT FOUND:", pdf_path)
            return ""

        print("📄 Using HTML:", html_path)

        with open(html_path, "r", encoding="utf-8", errors="ignore") as f:
            soup = BeautifulSoup(f, "html.parser")

        texts = []

        # 🔥 PRIORITY: DIV BLOCKS (layout text)
        for div in soup.find_all("div"):
            t = div.get_text(" ", strip=True)
            if t and len(t) > 3:
                texts.append(t)

        # 🔥 FALLBACK: SPANS (if div fails)
        if len(texts) < 50:
            for span in soup.find_all("span"):
                t = span.get_text(" ", strip=True)
                if t and len(t) > 3:
                    texts.append(t)

        # 🔥 REMOVE DUPLICATES
        texts = list(dict.fromkeys(texts))

        text = " ".join(texts)
        text = re.sub(r"\s+", " ", text).strip()

        print("📄 Extracted length:", len(text))

        return text

    except Exception as e:
        print("❌ HTML extraction error:", e)
        return ""


# ============================================
# 🔥 FIELD EXTRACTION
# ============================================

def extract_case_number(text):
    patterns = [
        r"(CIVIL\s+APPEAL\s+NO\.?\s*\d+.*?\d{4})",
        r"(CRIMINAL\s+APPEAL\s+NO\.?\s*\d+.*?\d{4})",
        r"(SLP\s*\(.*?\)\s*NO\.?\s*\d+.*?\d{4})",
        r"(WRIT\s+PETITION.*?\d{4})"
    ]

    for p in patterns:
        m = re.search(p, text, re.IGNORECASE)
        if m:
            return m.group(1).strip()

    return "UNKNOWN_CASE"


def extract_parties(text):
    m = re.search(r"([A-Z][A-Za-z .,&]+)\s+Versus\s+([A-Z][A-Za-z .,&]+)", text)
    if m:
        return {
            "petitioner": m.group(1).strip(),
            "respondent": m.group(2).strip()
        }

    return {"petitioner": "Unknown", "respondent": "Unknown"}


def extract_category(text):
    t = text.lower()

    if "criminal" in t:
        return "Criminal"
    if "civil" in t:
        return "Civil"
    if "service" in t:
        return "Service"
    if "tax" in t:
        return "Taxation"

    return "Unknown"


def extract_acts(text):
    acts = re.findall(r"([A-Za-z\s]+Act,?\s*\d{4})", text)
    return list(set([a.strip() for a in acts]))[:10]


def extract_points(text):
    keywords = [
        "murder", "dowry", "contract",
        "termination", "reinstatement",
        "tax", "fraud"
    ]
    return [k.capitalize() for k in keywords if k in text.lower()][:5]


def generate_headnote(text):
    t = text.lower()

    if "appeal dismissed" in t:
        return "Appeal dismissed by the Court."
    if "appeal allowed" in t:
        return "Appeal allowed by the Court."

    return text[:300]


# ============================================
# 🔥 SAVE SAFE
# ============================================

def save_judgment_safe(data):
    existing = db.judgments.find_one({"ingestionId": data["ingestionId"]})

    if existing:
        db.judgments.update_one(
            {"ingestionId": data["ingestionId"]},
            {"$set": data}
        )
        print("🔁 Updated existing")
    else:
        db.judgments.insert_one(data)
        print("✅ Inserted new")


# ============================================
# 🔥 MAIN PROCESSOR
# ============================================

def process_judgment_core(ingestion_id):
    try:
        oid = ObjectId(ingestion_id)

        ingestion = db.judgmentingestions.find_one({"_id": oid})
        if not ingestion:
            raise Exception("Ingestion not found")

        relative_path = ingestion["file"].get("relativePath")
        if not relative_path:
            raise Exception("relativePath missing")

        file_path = os.path.join(BASE_PATH, relative_path)

        print("📂 File:", file_path)

        if not os.path.exists(file_path):
            raise Exception("File missing on disk")

        text = extract_text(file_path)

        if len(text) < 500:
            raise Exception("Extraction failed (too short)")

        case_number = extract_case_number(text)
        parties = extract_parties(text)
        category = extract_category(text)
        acts = extract_acts(text)
        points = extract_points(text)
        headnote = generate_headnote(text)

        print("📊 Case:", case_number)
        print("📊 Category:", category)

        judgment_data = {
            "ingestionId": oid,
            "caseNumber": case_number,
            "category": category,
            "parties": parties,
            "actReferences": acts,
            "pointsOfLaw": points,
            "headnote": headnote,
            "fullText": text[:100000],
            "createdAt": datetime.utcnow()
        }

        save_judgment_safe(judgment_data)

        db.judgmentingestions.update_one(
            {"_id": oid},
            {
                "$set": {
                    "nlpProcessed": True,
                    "status": "COMPLETED",
                    "stage": "DONE",
                    "progress": 100,
                    "updatedAt": datetime.utcnow()
                }
            }
        )

        print("✅ DONE:", ingestion_id)
        return True

    except Exception as e:
        print("❌ ERROR:", ingestion_id)
        print(traceback.format_exc())

        db.judgmentingestions.update_one(
            {"_id": ObjectId(ingestion_id)},
            {
                "$set": {
                    "status": "FAILED",
                    "stage": "ERROR",
                    "progress": 0,
                    "error": str(e),
                    "updatedAt": datetime.utcnow()
                }
            }
        )

        return False
