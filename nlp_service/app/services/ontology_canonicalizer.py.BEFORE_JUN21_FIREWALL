}


def normalize_text(value):
    value = value.strip().lower()
    value = re.sub(r"\s+", " ", value)
    return value


def canonicalize_point(point):
    if not point:
        return None

    point = normalize_text(point)

    return point.title()


def canonicalize_act(act_name):
    if not act_name:
        return None

    act_name = normalize_text(act_name)

    for prefix in ACT_PREFIX_BLACKLIST:
        if act_name.startswith(prefix):
            return None

    if re.match(r"^[a-z]{1,3}\s", act_name):
        return None

    if len(act_name.split()) > 8:
        return None

    if re.search(r"^[a-z]\)", act_name):
        return None

    if re.search(r"^[a-z]{1,4}\s+of\s+the", act_name):
        return None

    if ")" in act_name and "act," in act_name:
        return None

    if act_name.startswith("otropic"):
        return None

    if act_name.startswith("isions"):
        return None

    if act_name.startswith("anding"):
        return None

    if act_name.startswith("he "):
        return None

    for term in ACT_NOISE_TERMS:
        if term in act_name:
            return None

    for phrase in ACT_PHRASE_BLACKLIST:
        if phrase in act_name:
            return None

    patterns = [
        r"(constitution of india)",
        r"([a-z][a-z &()\-]{0,50}? act, \d{4})",
        r"([a-z][a-z &()\-]{0,50}? rules, \d{4})"
    ]

    matches = []

    for pattern in patterns:
        matches.extend(
            re.findall(pattern, act_name, flags=re.I)
        )

    if matches:
        return matches[-1].title()

    return None
