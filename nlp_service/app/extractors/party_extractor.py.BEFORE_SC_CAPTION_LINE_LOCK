import re


# =========================================================
# 🔥 NORMALIZE SPACES
# =========================================================

def normalize_spaces(text):

    text = re.sub(r"\r", "\n", text)

    text = re.sub(r"\t", " ", text)

    text = re.sub(r"[ ]+", " ", text)

    text = re.sub(r"\n+", "\n", text)

    return text.strip()


ROLE_WORDS = [
    "APPELLANT",
    "APPELLANT(S)",
    "PETITIONER",
    "PETITIONER(S)",
    "RESPONDENT",
    "RESPONDENT(S)",
    "ACCUSED",
    "COMPLAINANT",
    "APPLICANT",
]

NOISE_PATTERNS = [
    r"IN THE SUPREME COURT OF INDIA",
    r"SUPREME COURT OF INDIA",
    r"HIGH COURT OF [A-Z ]+",
    r"CIVIL APPELLATE JURISDICTION",
    r"CRIMINAL APPELLATE JURISDICTION",
    r"CIVIL ORIGINAL JURISDICTION",
    r"CRIMINAL ORIGINAL JURISDICTION",
    r"JUDGMENT",
    r"J U D G M E N T",
    r"ORDER",
    r"REPORTABLE",
    r"NON[- ]REPORTABLE",
    r"DATED[: ]",
]

def remove_noise(text):

    for pattern in NOISE_PATTERNS:
        text = re.sub(pattern, " ", text, flags=re.I)

    text = re.sub(
        r"(CIVIL|CRIMINAL|WRIT|SPECIAL LEAVE|TRANSFER).{0,80}?NO\.?\s*[\w\-\/() ]+OF\s+\d{4}",
        " ",
        text,
        flags=re.I,
    )

    text = re.sub(
        r"(?:CIVIL|CRIMINAL)\s+APPEAL\s+NOS?\.?\s*[\d\-/, ]+\s+OF\s+\d{4}",
        " ",
        text,
        flags=re.I,
    )

    text = re.sub(
        r"\b\d+(?:\s*[-/]\s*\d+)*\s+OF\s+\d{4}\b",
        " ",
        text,
        flags=re.I,
    )

    text = re.sub(r"FOR THE APPELLANT.*", " ", text, flags=re.I)
    text = re.sub(r"FOR THE RESPONDENT.*", " ", text, flags=re.I)

    return text


def clean_name(text):

    if not text:
        return "Unknown"

    text = normalize_spaces(text)
    text = remove_noise(text)

    text = re.sub(
        r"\.*\s*(APPELLANT|APPELLANT\(S\)|PETITIONER|PETITIONER\(S\)|RESPONDENT|RESPONDENT\(S\)|ACCUSED|COMPLAINANT|APPLICANT)",
        " ",
        text,
        flags=re.I,
    )

    text = re.sub(r"[.…·]{2,}", " ", text)
    text = re.sub(r"[^A-Za-z0-9\/ ,.()&'\-]", " ", text)

    text = re.sub(r"\s+", " ", text)
    text = text.strip(" .,-:")

    if len(text) < 2:
        return "Unknown"


    # =====================================================
    # 🔥 REMOVE ARISING OUT OF POLLUTION
    # =====================================================

    text = re.sub(
        r"""
        ^.*?
        \(?
        \s*ARISING\s+OUT\s+OF
        .*?\)
        \s*
        """,
        "",
        text,
        flags=re.I | re.X
    ).strip()

    text = re.sub(
        r"^\s*OF\s+\d{4}\s+",
        "",
        text,
        flags=re.I
    ).strip()

    return text.title()











