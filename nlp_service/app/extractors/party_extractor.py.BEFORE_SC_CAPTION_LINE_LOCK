    respondent = "Unknown"
    confidence = 0

    print("🔥 VERSUS HEADER SAMPLE 🔥")
    print(str(header)[:5000])
    print("🔥 END VERSUS HEADER SAMPLE 🔥")

    pet = re.search(
        r"PETITIONER\s*:\s*([\s\S]{1,300}?)\s*VS\.?",
        header,
        flags=re.I
    )

    res = re.search(
        r"RESPONDENT\s*:\s*([\s\S]{1,300}?)\s*DATE\s+OF\s+JUDGMENT",
