def extract_appellant_respondent(header):


    # =====================================================
    # 🔒 SC CAPTION NORMALIZATION FIREWALL
    # =====================================================

    header = re.sub(
        r"[…⋯•·]+",
        ".....",
        header
    )

    header = re.sub(
        r"\.{2,}",
        ".....",
        header
    )

    header = re.sub(
        r"\s+\.\.\.\.\.",
        " .....",
        header
    )

    # =====================================================
    # 🔒 MULTI-LINE SC CAPTION LOCK V4
    # =====================================================

    m = re.search(
        r"""
        ([A-Z][A-Z0-9 .,&'()/\-]{2,200})
        \s*
        [.…⋯•·]*\s*
        APPELLANT(?:\(S\))?
        .*?
        VERSUS
        .*?
        ([A-Z][A-Z0-9 .,&'()/\-]{2,200})
        \s*
        [.…⋯•·]*\s*
        RESPONDENT(?:\(S\))?
        """,
        header,
        flags=re.I | re.S | re.X | re.M
    )

    if m:

        pet_raw = m.group(1).strip()
        res_raw = m.group(2).strip()

        petitioner = clean_name(pet_raw)
        respondent = clean_name(res_raw)

        print("🔥 SC CAPTION LOCK V4")
        print({
            "petitioner": petitioner,
            "respondent": respondent
        })

        return {
            "petitioner": petitioner,
            "respondent": respondent,
            "confidence": 98
        }


    m = re.search(
        r"([A-Z][A-Z0-9 ,.&'()/\\-]{3,250})"
        r".{0,120}?"
        r"APPELLANT"
        r".{0,300}?"
        r"(VERSUS|VS\\.?|V\\.)"
        r".{0,300}?"
        r"([A-Z][A-Z0-9 ,.&'()/\\-]{3,350})"
        r".{0,120}?"
        r"RESPONDENT",
        header,
        flags=re.I | re.S
    )

    if not m:
        return {
            "petitioner": "Unknown",
            "respondent": "Unknown",
            "confidence": 0
        }

    return {
        "petitioner": clean_name(m.group(1)),
        "respondent": clean_name(m.group(3)),
        "confidence": 85
    }


