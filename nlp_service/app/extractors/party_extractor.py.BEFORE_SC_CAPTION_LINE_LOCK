def extract_sc_caption(header):

    # =====================================================
    # 🔥 SC CAPTION LOCK V2
    # =====================================================

    caption_lock = re.search(
        r"""
        ([A-Z][A-Z0-9.,&'()/\-\s]{2,250})
        \s*
        [.…·]{2,}
        \s*
        APPELLANT(?:\(S\))?

        [\s\S]{0,2000}?

        (?:VERSUS|VS\.?|V\.)

        [\s\S]{0,2000}?

        ([A-Z][A-Z0-9.,&'()/\-\s]{2,250})
        \s*
        [.…·]{2,}
        \s*
        RESPONDENT(?:\(S\))?
        """,
        header,
        flags=re.I | re.S | re.X
    )

    if caption_lock:

        petitioner = clean_name(
            caption_lock.group(1)
        )

        respondent = clean_name(
            caption_lock.group(2)
        )

        print("🔥 SC CAPTION LOCK V2:")
        print({
            "petitioner": petitioner,
            "respondent": respondent
        })

        return {
            "petitioner": petitioner,
            "respondent": respondent,
            "confidence": 98
        }

    m = re.search(
        r"""
        ^\s*
        ([A-Z][A-Z0-9.,&'()/\- ]{2,250})
        \s*
        \.{2,}
        \s*
        APPELLANT(?:\(S\))?

        .*?

        VERSUS

        .*?

        ^\s*
        ([A-Z][A-Z0-9.,&'()/\- ]{2,250})
        \s*
        \.{2,}
        \s*
        RESPONDENT(?:\(S\))?
        """,
        header,
        flags=re.I | re.S | re.M | re.X
    )

    if not m:

        return {
            "petitioner": "Unknown",
            "respondent": "Unknown",
            "confidence": 0
        }

    # =====================================================
    # 🔥 SC CAPTION OCR RECOVERY FIREWALL
    # =====================================================

    pet_raw = normalize_spaces(m.group(1))
    res_raw = normalize_spaces(m.group(2))

    for pattern in [
        r"(?is)IN\s+THE\s+SUPREME\s+COURT.*?$",
        r"(?is)(?:CIVIL|CRIMINAL)\s+APPELLATE\s+JURISDICTION.*?$",
        r"(?is)ARISING\s+OUT\s+OF.*?$",
        r"(?is)CIVIL\s+APPEAL\s+NOS?.*?$",
        r"(?is)CRIMINAL\s+APPEAL\s+NOS?.*?$",
        r"(?is)SPECIAL\s+LEAVE\s+PETITION.*?$",
        r"(?is)WRIT\s+PETITION.*?$",
    ]:
        pet_raw = re.sub(pattern, " ", pet_raw)
        res_raw = re.sub(pattern, " ", res_raw)

    pet_raw = re.sub(
        r"(?im)^(page\s+\d+.*|digitally\s+signed.*|signature\s+not\s+verified.*)$",
        " ",
        pet_raw
    )

    res_raw = re.sub(
        r"(?im)^(page\s+\d+.*|digitally\s+signed.*|signature\s+not\s+verified.*)$",
        " ",
        res_raw
    )

    pet_raw = normalize_spaces(pet_raw)
    res_raw = normalize_spaces(res_raw)

    print("🔥 SC CAPTION RAW CLEANED:")
    print({
        "pet_raw": pet_raw,
        "res_raw": res_raw
    })

    petitioner = clean_name(pet_raw)
    respondent = clean_name(res_raw)

    print("🔥 SC CAPTION MATCH:")
    print({
        "petitioner": petitioner,
        "respondent": respondent
    })

    print("🔥 SC CAPTION RAW GROUPS:")
    print({
        "pet_raw": m.group(1),
        "res_raw": m.group(2)
    })

    return {
        "petitioner": petitioner,
        "respondent": respondent,
        "confidence": 95
    }



def extract_label_based(header):

    pet = re.search(
        r"PETITIONER\s*:\s*([A-Z0-9 ,.&'()/\\-]{2,300})",
        header,
        flags=re.I
    )

    res = re.search(
        r"RESPONDENT\s*:\s*([A-Z0-9 ,.&'()/\\-]{2,300})",
        header,
        flags=re.I
    )

    print("🔥 LABEL PET RAW:")
    print(pet.group(1) if pet else None)

    print("🔥 LABEL RES RAW:")
    print(res.group(1) if res else None)
    return {
        "petitioner":
            clean_name(pet.group(1))
            if pet else "Unknown",

        "respondent":
            clean_name(res.group(1))
            if res else "Unknown",

        "confidence":
            (
                90
                if pet and res
                else 0
            )
    }


def extract_versus_based(header):

