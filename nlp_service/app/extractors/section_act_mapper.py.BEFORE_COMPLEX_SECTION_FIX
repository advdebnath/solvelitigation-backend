# =========================================================


def extract_act_names(mapped_sections):

    acts = set()

    for item in mapped_sections:

        if not isinstance(item, dict):
            continue

        act = item.get("act")

        if act:

            acts.add(act)

    return sorted(list(acts))


# =========================================================
# 🔥 FALLBACK CATEGORY INFERENCE
# =========================================================


def infer_category_from_act(act_names):

    if not act_names:
        return "Civil"

    text = " ".join(act_names).lower()

    if "ipc" in text or "criminal" in text:
        return "Criminal"

    if "service" in text:
        return "Service"

    if "tax" in text or "gst" in text or "income tax" in text:
        return "Taxation"

    if "companies act" in text or "sebi" in text or "insolvency" in text:
        return "Corporate"

    return "Civil"


def infer_category_from_sections(sections):

    if not sections:
        return "Civil"

    text = " ".join([str(s) for s in sections]).lower()

    if "302" in text or "420" in text:
        return "Criminal"

    if "service" in text:
        return "Service"

    return "Civil"


def infer_category_from_case_number(case_number):

    if not case_number:
        return "Civil"

    text = str(case_number).lower()

    if "criminal" in text:
        return "Criminal"

    if "service" in text:
        return "Service"

    if "tax" in text:
        return "Taxation"

    return "Civil"


def is_ontology_eligible(category):

    return category not in [None, "", "Unknown"]
