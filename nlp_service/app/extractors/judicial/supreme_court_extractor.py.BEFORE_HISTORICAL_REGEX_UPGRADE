# =========================================================
# 🔥 SUPREME COURT EXTRACTOR
# =========================================================

import re

from app.extractors.judicial.shared_utils import (build_case_object,
                                                  clean_case_number,
                                                  normalize_ocr)


SC_PATTERNS = [

    (
        r"(CIVIL\s+APPEAL\s+NO\s*\(?S\)?\.?\s*[\d\-–]+/\d{4})",
        "CIVIL"
    ),

    (
        r"(CRIMINAL\s+APPEAL\s+NO\s*\(?S\)?\.?\s*[\d\-–]+/\d{4})",
        "CRIMINAL"
    ),


    # =====================================================
    # 🔥 MODERN SUPREME COURT APPEALS
    # =====================================================

    (
        r"(CIVIL\s+APPEAL\s+NO\.?\(?S\)?\.?\s*[\d\-–]+(?:/\d{4}))",
        "CIVIL"
    ),

    (
        r"(CRIMINAL\s+APPEAL\s+NO\.?\(?S\)?\.?\s*[\d\-–]+(?:/\d{4}))",
        "CRIMINAL"
    ),

    (
        r"(CIVIL\s+APPEAL\s+NO\.?\s*\d+\s+OF\s+\d{4})",
        "CIVIL"
    ),

    (
        r"(CRIMINAL\s+APPEAL\s+NO\.?\s*\d+\s+OF\s+\d{4})",
        "CRIMINAL"
    ),
    (
        r"(SPECIAL\s+LEAVE\s+PETITION\s*\(?[A-Z]*\)?\s*NO\.?\(?S\)?\.?\s*[\d\-\/]+\s*(?:OF\s+\d{4})?)",
        "SPECIAL_LEAVE"
    ),
    (r"(WRIT\s+PETITION.*?NO\.?\s*\d+\s+OF\s+\d{4})", "WRIT"),
    (r"(REVIEW\s+PETITION.*?NO\.?\s*\d+\s+OF\s+\d{4})", "REVIEW"),
]


def extract_sc_case_number(text):

    text = normalize_ocr(text)

    upper = text.upper()

    for pattern, case_type in SC_PATTERNS:

        try:

            matches = re.findall(pattern, upper, flags=re.I)

        except Exception as e:

            print("❌ SC REGEX ERROR:")
            print(str(e))

            continue

        for match in matches:

            value = clean_case_number(match)

            print("🔥 SC MATCH:")
            print(value)

            if re.search(r"\d{2,}", value):

                return build_case_object(
                    case_number=value,
                    court_type="SUPREME COURT",
                    case_type=case_type,
                    confidence=100,
                    source="SC_EXTRACTOR_V2",
                )


    # =====================================================
    # 🔥 HISTORICAL JUDIS FALLBACK
    # =====================================================

    petitioner_match = re.search(
        r"PETITIONER:\s*([A-Z\s\.\&\,\-]+?)\s*VS\.?",
        upper,
        re.I | re.S
    )

    respondent_match = re.search(
        r"RESPONDENT:\s*([A-Z\s\.\&\,\-]+?)\s*DATE OF",
        upper,
        re.I | re.S
    )

    print("🔥 PET_MATCH:")
    print(bool(petitioner_match))

    print("🔥 RESP_MATCH:")
    print(bool(respondent_match))

    if petitioner_match and respondent_match:

        petitioner = re.sub(
            r"\s+",
            " ",
            petitioner_match.group(1)
        ).strip()

        respondent = re.sub(
            r"\s+",
            " ",
            respondent_match.group(1)
        ).strip()

        synthetic_case = (
            f"{petitioner} VS. {respondent}"
        )

        print("🔥 SC HISTORICAL FALLBACK:")
        print(synthetic_case)

        return build_case_object(
            case_number=synthetic_case,
            court_type="SUPREME COURT",
            case_type="HISTORICAL",
            confidence=85,
            source="SC_HISTORICAL_FALLBACK"
        )

    return None

