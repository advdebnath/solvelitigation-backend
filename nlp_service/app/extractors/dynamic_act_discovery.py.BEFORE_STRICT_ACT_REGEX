import re


ACT_PATTERNS = [

    # Hindu Marriage Act, 1955
    r'([A-Z][A-Za-z&,\-\s]{3,120}? Act[, ]+\d{4})',

    # Constitution of India
    r'([A-Z][A-Za-z&,\-\s]{3,120}? Constitution)',

    # Rules
    r'([A-Z][A-Za-z&,\-\s]{3,120}? Rules[, ]+\d{4})',

    # Regulations
    r'([A-Z][A-Za-z&,\-\s]{3,120}? Regulations[, ]+\d{4})',
]


def discover_dynamic_acts(text=""):

    if not text:
        return []

    acts = []

    for pattern in ACT_PATTERNS:

        matches = re.findall(
            pattern,
            text,
            flags=re.I
        )

        for m in matches:

            value = str(m).strip()

            value = re.sub(
                r'^(under|of|and|the|schedule to|as per|provisions of)\s+',
                '',
                value,
                flags=re.I
            )

            value = re.sub(
                r'\s+',
                ' ',
                value
            )

            value = value.strip(' ,.;:')

            value = re.sub(
                r"\s+",
                " ",
                value
            )

            if len(value) < 5:
                continue

            acts.append(value)

    acts = sorted(
        list(
            dict.fromkeys(acts)
        )
    )

    print("🔥 DYNAMIC ACT DISCOVERY 🔥")
    print(acts)

    return acts
