import re

# =========================================================
# 🔥 CONSTANTS
# =========================================================

ROLE_WORDS = [

    "APPELLANT",
    "APPELLANT(S)",
    "PETITIONER",
    "PETITIONER(S)",
    "RESPONDENT",
    "RESPONDENT(S)",
    "ACCUSED",
    "COMPLAINANT",
    "APPLICANT"
]

NOISE_PATTERNS = [

    r"IN THE SUPREME COURT OF INDIA",
    r"SUPREME COURT OF INDIA",
    r"HIGH COURT OF [A-Z ]+",
    r"CIVIL APPELLATE JURISDICTION",
    r"CRIMINAL APPELLATE JURISDICTION",
    r"CIVIL ORIGINAL JURISDICTION",
    r"CRIMINAL ORIGINAL JURISDICTION",
    r"JUDGMENT",
    r"J U D G M E N T",
    r"ORDER",
    r"REPORTABLE",
    r"NON[- ]REPORTABLE",
    r"DATED[: ]",
]

# =========================================================
# 🔥 NORMALIZE SPACES
# =========================================================

def normalize_spaces(text):

    text = re.sub(
        r"\r",
        "\n",
        text
    )

    text = re.sub(
        r"\t",
        " ",
        text
    )

    text = re.sub(
        r"[ ]+",
        " ",
        text
    )

    text = re.sub(
        r"\n+",
        "\n",
        text
    )

    return text.strip()

# =========================================================
# 🔥 REMOVE NOISE
# =========================================================

def remove_noise(text):

    for pattern in NOISE_PATTERNS:

        text = re.sub(

            pattern,

            " ",

            text,

            flags=re.I
        )

    # =====================================================
    # 🔥 REMOVE CASE NUMBERS
    # =====================================================

    text = re.sub(

        r"(CIVIL|CRIMINAL|WRIT|SPECIAL LEAVE|TRANSFER)"
        r".{0,80}?NO\.?\s*[\w\-\/() ]+OF\s+\d{4}",

        " ",

        text,

        flags=re.I
    )

    # =====================================================
    # 🔥 REMOVE ADVOCATES
    # =====================================================

    text = re.sub(

        r"FOR THE APPELLANT.*",

        " ",

        text,

        flags=re.I
    )

    text = re.sub(

        r"FOR THE RESPONDENT.*",

        " ",

        text,

        flags=re.I
    )

    return text

# =========================================================
# 🔥 CLEAN PARTY NAME
# =========================================================

def clean_name(text):

    if not text:

        return "Unknown"

    text = normalize_spaces(text)

    text = remove_noise(text)

    # =====================================================
    # 🔥 REMOVE ROLE LABELS
    # =====================================================

    text = re.sub(

        r"\.*\s*("
        r"APPELLANT"
        r"|APPELLANT\(S\)"
        r"|PETITIONER"
        r"|PETITIONER\(S\)"
        r"|RESPONDENT"
        r"|RESPONDENT\(S\)"
        r"|ACCUSED"
        r"|COMPLAINANT"
        r"|APPLICANT"
        r")",

        " ",

        text,

        flags=re.I
    )

    # =====================================================
    # 🔥 REMOVE DOT CHAINS
    # =====================================================

    text = re.sub(
        r"[.…·]{2,}",
        " ",
        text
    )

    # =====================================================
    # 🔥 REMOVE SYMBOL NOISE
    # =====================================================

    text = re.sub(

        r"[^A-Za-z0-9\/ ,.()&'\-]",

        " ",

        text
    )

    # =====================================================
    # 🔥 NORMALIZE
    # =====================================================

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    text = text.strip(" .,-:")

    # =====================================================
    # 🔥 LIMIT EXTREME LENGTHS
    # =====================================================

    words = text.split()

    if len(words) > 25:

        words = words[:25]

    text = " ".join(words)

    # =====================================================
    # 🔥 SAFETY
    # =====================================================

    if len(text) < 2:

        return "Unknown"

    return text.title()

# =========================================================
# 🔥 ROLE-BASED EXTRACTION
# =========================================================

def extract_role_based(header):

    petitioner = "Unknown"

    respondent = "Unknown"

    confidence = 0

    # =====================================================
    # 🔥 PETITIONER / APPELLANT
    # =====================================================

    pet_match = re.search(

        r"([A-Z0-9\/ ,.()&'\-\n]{3,400}?)"
        r"\s*[.…·]{0,10}\s*"
        r"(APPELLANT|PETITIONER|APPLICANT)",

        header,

        flags=re.I | re.S
    )

    if pet_match:

        petitioner = clean_name(

            pet_match.group(1)
        )

        confidence += 45

    # =====================================================
    # 🔥 RESPONDENT
    # =====================================================

    res_match = re.search(

        r"(VERSUS|VS\.?|V\.)\s+"
        r"([A-Z0-9\/ ,.()&'\-\n]{3,500}?)"
        r"\s*[.…·]{0,10}\s*"
        r"(RESPONDENT|ACCUSED)",

        header,

        flags=re.I | re.S
    )

    if res_match:

        respondent = clean_name(

            res_match.group(2)
        )

        confidence += 45

    return {

        "petitioner": petitioner,

        "respondent": respondent,

        "confidence": confidence
    }

# =========================================================
# 🔥 FALLBACK VERSUS EXTRACTION
# =========================================================

def extract_versus_based(header):

    petitioner = "Unknown"

    respondent = "Unknown"

    confidence = 0

    versus_match = re.search(

        r"\n\s*"
        r"([A-Z][A-Z0-9\/ ,.()&'\-]{2,250})"
        r"\s*\n.*?"
        r"(VERSUS|VS\.?|V\.)"
        r".*?\n\s*"
        r"([A-Z][A-Z0-9\/ ,.()&'\-]{2,350})",

        header,

        flags=re.I | re.S
    )

    if versus_match:

        petitioner = clean_name(

            versus_match.group(1)
        )

        respondent = clean_name(

            versus_match.group(3)
        )

        confidence = 70

    return {

        "petitioner": petitioner,

        "respondent": respondent,

        "confidence": confidence
    }

# =========================================================
# 🔥 MAIN EXTRACTION
# =========================================================

def extract_parties(text):

    try:

        if not text:

            return {

                "petitioner": "Unknown",

                "respondent": "Unknown",

                "confidence": 0
            }

        # =====================================================
        # 🔥 HEADER ZONE
        # =====================================================

        header = text[:12000]

        header = normalize_spaces(header)

        # =====================================================
        # 🔥 ROLE-BASED EXTRACTION
        # =====================================================

        result = extract_role_based(header)

        # =====================================================
        # 🔥 FALLBACK VERSUS
        # =====================================================

        if (

            result["petitioner"] == "Unknown"
            or
            result["respondent"] == "Unknown"
        ):

            fallback = extract_versus_based(header)

            if result["petitioner"] == "Unknown":

                result["petitioner"] = fallback["petitioner"]

            if result["respondent"] == "Unknown":

                result["respondent"] = fallback["respondent"]

            result["confidence"] = max(

                result["confidence"],

                fallback["confidence"]
            )

        # =====================================================
        # 🔥 FINAL SAFETY
        # =====================================================

        if result["petitioner"] == result["respondent"]:

            result["confidence"] -= 20

        result["confidence"] = max(
            0,
            min(100, result["confidence"])
        )

        print(

            "✅ Parties Extracted:",

            result
        )

        return result

    except Exception as e:

        print(
            "❌ PARTY EXTRACTION ERROR:",
            e
        )

        return {

            "petitioner": "Unknown",

            "respondent": "Unknown",

            "confidence": 0
        }
