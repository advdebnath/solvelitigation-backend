import re

# =========================================================
# 🔥 OCR / FOOTER / TIMESTAMP CLEANER
# =========================================================

NOISE_PATTERNS = [
    # -----------------------------------------------------
    # TIMESTAMPS
    # -----------------------------------------------------
    r"\b\d{1,2}:\d{2}:\d{2}\b",
    r"\b\d{2}\.\d{2}\.\d{4}\b",
    r"\b\d{4}\.\d{2}\.\d{2}\b",
    # -----------------------------------------------------
    # DIGITAL SIGNATURES
    # -----------------------------------------------------
    r"Digitally signed by.*",
    r"Signed by.*",
    r"Verified digitally.*",
    # -----------------------------------------------------
    # OCR FOOTERS
    # -----------------------------------------------------
    r"IST Reason:.*",
    r"Downloaded on :.*",
    r"Page \d+ of \d+",
    r"::: Uploaded on.*",
    r"http[s]?://\S+",
    # -----------------------------------------------------
    # COURT REPORT HEADER BLEED
    # -----------------------------------------------------
    r"SUPREME COURT REPORTS.*",
    r"HIGH COURT OF .*",
    # -----------------------------------------------------
    # REPEATED SYMBOLS
    # -----------------------------------------------------
    r"[_\-]{5,}",
    r"[=]{5,}",
    # -----------------------------------------------------
    # BROKEN OCR SPACING
    # -----------------------------------------------------
    r"\b(?:[A-Za-z]\s){3,}[A-Za-z]\b",
]

# =========================================================
# 🔥 NORMALIZATION
# =========================================================


def normalize_spacing(text):

    # preserve line structure

    text = re.sub(r"[ \t]+", " ", text)

    text = re.sub(r"\n{3,}", "\n\n", text)

    text = re.sub(r"([.,])\1+", r"\1", text)

    return text.strip()


# =========================================================
# 🔥 MAIN SANITIZER
# =========================================================


def sanitize_legal_text(text=""):

    if not text:
        return ""

    cleaned = text

    # -----------------------------------------------------
    # REMOVE NOISE
    # -----------------------------------------------------

    print("SANITIZER_START_LENGTH")
    print(len(cleaned))

    for pattern in NOISE_PATTERNS:

        before = len(cleaned)

        cleaned = re.sub(pattern, " ", cleaned, flags=re.I)

        after = len(cleaned)

        if before != after:
            print("SANITIZER_PATTERN_HIT")
            print(pattern)
            print(before)
            print(after)

    # -----------------------------------------------------
    # 🔥 REMOVE DIGITAL SIGNATURE POLLUTION
    # -----------------------------------------------------

    digital_signature_patterns = [
        r"Digitally\s+signed\s+by.*?(\n|$)",
        r"Digitally\s+signed\s+on.*?(\n|$)",
        r"Signed\s+by.*?(\n|$)",
        r"Signature\s+Not\s+Verified.*?(\n|$)",
        r"Downloaded\s+on.*?(\n|$)",
        r"Signing\s+Date.*?(\n|$)",
        r"Certificate\s+Serial\s+Number.*?(\n|$)",
        r"Certificate\s+Fingerprint.*?(\n|$)",
        r"Verified\s+by.*?(\n|$)",
        r"Page\s+\d+\s+of\s+\d+.*?Digitally.*?(\n|$)",
    ]

    for pattern in digital_signature_patterns:

        before = len(cleaned)

        cleaned = re.sub(pattern, " ", cleaned, flags=re.I)

        after = len(cleaned)

        if before != after:
            print("DIGITAL_PATTERN_HIT")
            print(pattern)
            print(before)
            print(after)

    # -----------------------------------------------------
    # REMOVE MULTIPLE SPACES
    # -----------------------------------------------------

    cleaned = normalize_spacing(cleaned)

    print("SANITIZER_LENGTH_AFTER_NORMALIZE")
    print(len(cleaned))

    # -----------------------------------------------------
    # REMOVE SHORT OCR GARBAGE LINES
    # -----------------------------------------------------

    lines = cleaned.splitlines()

    final_lines = []

    for line in lines:

        stripped = line.strip()

        if not stripped:
            continue

        # reject garbage fragments

        if len(stripped) < 3:
            continue

        final_lines.append(stripped)

    cleaned = "\n".join(final_lines)

    # -----------------------------------------------------
    # FINAL NORMALIZATION
    # -----------------------------------------------------

    cleaned = normalize_spacing(cleaned)

    return cleaned
