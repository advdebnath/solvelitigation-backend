# =========================================================
# 🔥 SCORE PARAGRAPH
# =========================================================

def score_operational_paragraph(para):

    lower = para.lower()

    # =====================================================
    # 🔥 INVALID FILTER
    # =====================================================

    for term in INVALID_OPERATIVE_TERMS:

        if term in lower:

            return 0, []

    score = 0

    findings = []

    # =====================================================
    # 🔥 PATTERN MATCHING
    # =====================================================

    for label, patterns in OPERATIVE_PATTERNS.items():

        for pattern in patterns:

            if re.search(
                pattern,
                lower,
                re.I
            ):

                score += 25

                findings.append(label)

    # =====================================================
    # 🔥 DISPOSAL BOOST
    # =====================================================

    disposal_terms = [

        "accordingly",
        "therefore",
        "hence",
        "resultantly",
        "ordered accordingly",
        "disposed of",
        "stands disposed",
        "in view of",
    ]

    if any(

        word in lower

        for word in disposal_terms
    ):

        score += 15

    # =====================================================
    # 🔥 FINAL SHORT PARA BOOST
    # =====================================================

    if len(lower) < 1200:

        score += 5

    return score, findings

# =========================================================
# 🔥 EXTRACT PARA NUMBER
# =========================================================

def extract_para_number(para):

    patterns = [

        r"\b(\d{1,3})\.\s",
        r"\((\d{1,3})\)",
        r"paragraph\s+(\d{1,3})",
    ]

    for pattern in patterns:

        match = re.search(
            pattern,
            para,
            re.I
        )

        if match:

            return f"para-{match.group(1)}"

    return "para-unknown"

# =========================================================
# 🔥 MAIN ENGINE
# =========================================================

def extract_operative_order(text):

    try:

        if not text:

            return {

                "operative_order": [],
                "final_holding": None,
                "operative_para": None,
                "paragraph": None,
                "confidence": 0,
            }

        text = clean_text(text)

        paragraphs = split_paragraphs(text)

        if not paragraphs:

            return {

                "operative_order": [],
                "final_holding": None,
                "operative_para": None,
                "paragraph": None,
                "confidence": 0,
            }

        # =================================================
        # 🔥 PRIORITIZE LAST 35%
        # =================================================

        start_index = int(
            len(paragraphs) * 0.65
        )

        target_paragraphs = paragraphs[
            start_index:
        ]

        best_score = 0

        best_para = None

        best_findings = []

        # =================================================
        # 🔥 BOTTOM-UP SEARCH
        # =================================================

        for para in reversed(target_paragraphs):

            score, findings = score_operational_paragraph(
                para
            )

            if score > best_score:

                best_score = score

                best_para = para

                best_findings = findings

        # =================================================
        # 🔥 FINAL HOLDING
        # =================================================

        final_holding = None

        if best_findings:

            final_holding = ", ".join(

                list(
                    dict.fromkeys(
                        best_findings
                    )
                )
            )

        # =================================================
        # 🔥 OPERATIVE PARA
        # =================================================

        operative_para = None

        if best_para:

            operative_para = extract_para_number(
                best_para
            )

        # =================================================
        # 🔥 RESULT
        # =================================================

        result = {

            "operative_order":
                best_findings,

            "final_holding":
                final_holding,

            "operative_para":
                operative_para,

            "paragraph":
                best_para[:2000]
                if best_para else None,

            "confidence":
                min(
                    99,
                    best_score
                ),
        }

        print(
            "✅ Operative Order Extracted:"
        )

        print(result)

        return result

    except Exception as e:

        print(
            "❌ OPERATIVE ORDER ERROR:",
            e
        )

        return {

            "operative_order": [],
            "final_holding": None,
            "operative_para": None,
            "paragraph": None,
            "confidence": 0,
        }

