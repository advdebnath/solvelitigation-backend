import re

# =========================================================
# 🔥 CLEAN
# =========================================================

def clean_text(text):

    if not text:

        return ""

    # =====================================================
    # 🔥 PRESERVE PARAGRAPHS
    # =====================================================

    text = text.replace(
        "\r",
        "\n"
    )

    # normalize spaces only
    text = re.sub(
        r"[ \t]+",
        " ",
        text
    )

    # preserve paragraph structure
    text = re.sub(
        r"\n{3,}",
        "\n\n",
        text
    )

    return text.strip()

# =========================================================
# 🔥 SPLIT PARAGRAPHS
# =========================================================

def split_paragraphs(text):

    parts = re.split(
        r"\n\s*\n",
        text
    )

    cleaned = []

    for p in parts:

        para = p.strip()

        if len(para) > 20:

            cleaned.append(para)

    return cleaned

# =========================================================
# 🔥 INVALID OPERATIVE TERMS
# =========================================================

INVALID_OPERATIVE_TERMS = [

