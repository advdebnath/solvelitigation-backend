# =========================================================
# 🔥 NORMALIZE
# =========================================================

def normalize_text(text):

    text = text.lower()

    text = re.sub(
        r"\s+",
        " ",
        text
    )

    return text

# =========================================================
# 🔥 MAIN EXTRACTION
# =========================================================

def extract_points_of_law(text):

    try:

        if not text:

            return {

                "points_of_law": [],

                "category": "Unknown",

                "confidence": 0
            }

        # =====================================================
        # 🔥 NORMALIZE
        # =====================================================

        clean_text = normalize_text(

            text[:70000]
        )

        found_points = []

        category_scores = {}

        # =====================================================
        # 🔥 DETECT POINTS
        # =====================================================

        for category, topics in POINTS_DATABASE.items():

            score = 0

            for point_name, patterns in topics.items():

                matched = False

                for pattern in patterns:

                    if re.search(

                        pattern,

                        clean_text,

                        flags=re.I
                    ):

                        matched = True

                        score += 1

                        break

                if matched:

                    found_points.append({

                        "point": point_name,

                        "category": category
                    })

            category_scores[category] = score

        # =====================================================
        # 🔥 PRIMARY CATEGORY
        # =====================================================

        primary_category = "Unknown"

        highest_score = 0

        for category, score in category_scores.items():

            if score > highest_score:

                highest_score = score

                primary_category = category

        # =====================================================
        # 🔥 REMOVE DUPLICATES
        # =====================================================

        unique_points = []

        seen = set()

        for item in found_points:

            key = item["point"]

            if key not in seen:

                seen.add(key)

                unique_points.append(item)

        # =====================================================
        # 🔥 CONFIDENCE
        # =====================================================

        confidence = min(

            95,

            40 + (len(unique_points) * 10)
        )

        result = {

            "points_of_law": unique_points,

            "category": primary_category,

            "confidence": confidence
        }

        print(

            "✅ Points Of Law Extracted:",

            result
        )

        return result

    except Exception as e:

        print(
            "❌ POINT OF LAW EXTRACTION ERROR:",
            e
        )

        return {

            "points_of_law": [],

            "category": "Unknown",

            "confidence": 0
        }
